generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                         String              @id @default(cuid())
  email                      String              @unique
  name                       String
  password                   String
  role                       String              @default("USER")
  avatar                     String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  assets                     Asset[]
  approvedAssetLogs          AssetLog[]          @relation("ApprovedByUser")
  assetLogs                  AssetLog[]
  attendanceApprovals        Attendance[]        @relation("AttendanceApprover")
  attendanceRecords          Attendance[]
  auditLogs                  AuditLog[]
  cashTransactionApprovals   CashTransaction[]   @relation("CashTransactionApprover")
  cashTransactions           CashTransaction[]
  contractors                Contractor[]
  contractorContractsCreated ContractorContract[]       @relation("ContractorContractCreator")
  contractRatesCreated       ContractRate[]             @relation("ContractRateCreator")
  contractRateApprovals      ContractRate[]             @relation("ContractRateApprover")
  contractVariationsCreated  ContractVariation[]        @relation("ContractVariationCreator")
  contractVariationApprovals ContractVariation[]        @relation("ContractVariationApprover")
  contractorClaimsCreated    ContractorClaim[]          @relation("ContractorClaimCreator")
  contractorClaimApprovals   ContractorClaim[]          @relation("ContractorClaimApprover")
  employees                  Employee[]
  expenseApprovals           Expense[]           @relation("ExpenseApprover")
  expenses                   Expense[]
  fuelTransactions           FuelTransaction[]
  fuelUsageApprovals         FuelUsage[]         @relation("FuelUsageApprover")
  fuelUsages                 FuelUsage[]
  machinery                  Machinery[]
  machineryRates             MachineryRate[]
  maintenanceRecords         MaintenanceRecord[]
  recordAccesses             RecordAccess[]
  timesheetApprovalApprovals Timesheet[]         @relation("TimesheetApprovalApprover")
  timesheetApprovals         Timesheet[]         @relation("TimesheetApprovedBy")
  timesheets                 Timesheet[]
  transferApprovals          Transfer[]          @relation("TransferApprover")
  transfers                  Transfer[]
  userPermissions            UserPermission[]
  salaryHistories            SalaryHistory[]
  employeeContracts          EmployeeContract[]
  positionHistories          EmployeePositionHistory[]
  uploadedDocuments          EmployeeDocument[]
  employeeLeavesCreated      EmployeeLeave[]      @relation("EmployeeLeaveCreator")
  employeeLeavesApproved     EmployeeLeave[]      @relation("EmployeeLeaveApprover")
  projectAssignmentsCreated  EmployeeProjectAssignment[]
  payrollsCreated            Payroll[]            @relation("PayrollCreator")
  payrollsApproved           Payroll[]            @relation("PayrollApprover")
  employeeAuditEvents        EmployeeAuditEvent[]
  walletUsers                WalletUser[]
  payrollPaymentsCreated     PayrollPayment[]     @relation("PayrollPaymentCreator")
  accountingEntriesPosted    AccountingEntry[]    @relation("AccountingEntryPoster")
  payrollAdjustmentsCreated  PayrollAdjustment[]  @relation("PayrollAdjustmentCreator")
  payrollAuditLogs           PayrollAuditLog[]
  createdLoans               Loan[]               @relation("LoanCreator")
}

model RecordAccess {
  id         String   @id @default(cuid())
  entity     String
  entityId   String
  userId     String
  accessType String   @default("view")
  grantedBy  String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entity, entityId, userId])
  @@index([entity, entityId])
  @@index([userId])
  @@index([entity, userId])
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  label           String
  description     String?
  module          String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Employee {
  id                    String               @id @default(cuid())
  employeeNumber        String?              @unique
  fullName              String
  fatherName            String
  grandfatherName       String?
  gender                String               @default("male")
  dateOfBirth           DateTime?
  nationality           String?
  phoneNumber           String
  email                 String?
  address               String?
  nationalId            String?
  jobTitle              String
  department            String
  employmentType        String               @default("FULL_TIME")
  // Legacy mutable salary kept for backward compatibility.
  // Canonical salary is now derived from SalaryHistory (amountMinor, currency).
  salary                Float                @default(0)
  // Canonical current salary in minor currency units (e.g. AFN * 100).
  baseSalaryMinor       Int                  @default(0)
  currency              String               @default("AFN")
  workHoursPerDay       Int                  @default(9)
  overtimeRate          Float                @default(1.25)
  workStartTime         String               @default("07:00")
  workEndTime           String               @default("18:00")
  breakMinutes          Int                  @default(60)
  hireDate              DateTime
  status                String               @default("ACTIVE")
  employeeCategory      String?
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  probationEndDate      DateTime?
  terminationDate       DateTime?
  terminationReason     String?
  workLocation          String?
  // supervisor self-relation
  supervisorId          String?
  supervisor            Employee?            @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
  supervisees           Employee[]           @relation("EmployeeSupervisor")
  // Legacy field kept for compatibility; use terminationDate going forward.
  quitingDate           DateTime?
  idImageFront          String?
  idImageBack           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdBy             String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  assignedAssets        Asset[]
  assetOperatorLogs     AssetLog[]
  attendanceRecords     Attendance[]
  cashTransactions      CashTransaction[]
  creator               User                 @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  cashAccount           EmployeeCashAccount?
  expensesPaidBy        Expense[]            @relation("ExpensePaidBy")
  expensesPaidTo        Expense[]            @relation("ExpensePaidTo")
  transfersTo           Transfer[]           @relation("TransferTo")
  transfersFrom         Transfer[]           @relation("TransferFrom")
  salaryHistory         SalaryHistory[]
  contracts             EmployeeContract[]
  positionHistory       EmployeePositionHistory[]
  documents             EmployeeDocument[]
  leaves                EmployeeLeave[]
  assignments           EmployeeProjectAssignment[]
  payrolls              Payroll[]
  payrollLines          PayrollLine[]
  payrollAdjustments    PayrollAdjustment[]
  loans                 Loan[]
  auditEvents           EmployeeAuditEvent[]
  wallets               WalletEmployee[]

  @@index([phoneNumber])
  @@index([email])
  @@index([nationalId])
  @@index([department])
  @@index([status])
  @@index([employeeNumber])
  @@index([supervisorId])
  @@index([createdBy])
}

// --- HR: Salary history (immutable historical salary records) ---
model SalaryHistory {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amountMinor   Int
  currency      String   @default("AFN")
  effectiveFrom DateTime
  reason        String?
  notes         String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

// --- HR: Contracts (multiple per employee) ---
model EmployeeContract {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractNumber String  @unique
  contractType  String   @default("FIXED_TERM")
  startDate     DateTime
  endDate       DateTime?
  salaryMinor   Int      @default(0)
  currency      String   @default("AFN")
  position      String?
  department    String?
  project       String?
  status        String   @default("ACTIVE")
  fileUrl       String?
  notes         String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId, startDate])
  @@index([contractNumber])
  @@index([status])
}

// --- HR: Position / department history ---
model EmployeePositionHistory {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position       String
  department     String?
  project        String?
  supervisorId   String?
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  reason         String?
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@index([employeeId, effectiveFrom])
}

// --- HR: Documents ---
model EmployeeDocument {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType  String
  documentNumber String?
  issueDate     DateTime?
  expiryDate    DateTime?
  fileUrl       String?
  notes         String?
  uploadedById  String?
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
  @@index([documentType])
  @@index([expiryDate])
}

// --- HR: Leave types (configurable) ---
model EmployeeLeaveType {
  id           String  @id @default(cuid())
  name         String  @unique
  description  String?
  isPaid       Boolean @default(true)
  defaultDays  Int?
  isActive     Boolean @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  leaves       EmployeeLeave[]

  @@index([isActive])
}

// --- HR: Leave requests ---
model EmployeeLeave {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String?
  leaveType     EmployeeLeaveType? @relation(fields: [leaveTypeId], references: [id])
  startDate     DateTime
  endDate       DateTime
  days          Float    @default(0)
  reason        String?
  status        String   @default("PENDING")
  approvedById  String?
  approvedBy    User?    @relation("EmployeeLeaveApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  approvalNote  String?
  createdById   String?
  createdBy     User?    @relation("EmployeeLeaveCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId, startDate])
  @@index([status])
  @@index([leaveTypeId])
}

// --- HR: Project assignments (multi, historical) ---
model EmployeeProjectAssignment {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project     String
  position    String?
  startDate   DateTime
  endDate     DateTime?
  notes       String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([employeeId, startDate])
  @@index([project])
}

// --- HR: Payroll (immutable snapshot once approved) ---
model Payroll {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  currency      String   @default("AFN")
  // Lifecycle: DRAFT | APPROVED | PARTIALLY_PAID | PAID | NEEDS_RECALCULATION | CANCELLED
  status        String   @default("DRAFT")
  // STANDARD | FINAL_SETTLEMENT
  type          String   @default("STANDARD")
  // Sum of posted PayrollPayment.amountMinor (integer minor units).
  totalPaidMinor Int     @default(0)
  notes         String?
  walletId      String?
  wallet        Wallet?  @relation(fields: [walletId], references: [id])
  approvedById  String?
  approvedBy    User?    @relation("PayrollApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  revertedById  String?
  revertedAt    DateTime?
  reversalReason String?
  createdById   String?
  createdBy     User?    @relation("PayrollCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lines       PayrollLine[]
  allocations PayrollAdvanceAllocation[]
  loanAllocations PayrollLoanAllocation[]
  expenses    Expense[]
  payments    PayrollPayment[]
  adjustments PayrollAdjustment[]
  accountingEntries AccountingEntry[]
  projectAllocations PayrollLineProjectAllocation[]

  @@unique([employeeId, periodStart, periodEnd])
  @@index([employeeId, periodStart])
  @@index([status])
  @@index([walletId])
}

// Salary cost split across projects (Plan-payroll.pdf §2 action 11).
// `enteredValue` keeps HR's original entry (percent, or amount in AFN);
// `percentage`/`amountMinor` are the normalized result (sum to 100% / gross pay).
model PayrollLineProjectAllocation {
  id           String   @id @default(cuid())
  payrollId    String
  payroll      Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  project      String
  mode         String   // PERCENT | AMOUNT
  enteredValue Float
  percentage   Float
  amountMinor  Int
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([payrollId])
}

// One row per salary payment (partial payments are separate rows).
model PayrollPayment {
  id            String    @id @default(cuid())
  payrollId     String
  payroll       Payroll   @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  amountMinor   Int
  currency      String    @default("AFN")
  // CASH | BANK_TRANSFER | COMPANY_WALLET | ...
  paymentMethod String
  walletId      String?
  wallet        Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)
  reference     String?
  evidenceUrl   String?
  note          String?
  paidAt        DateTime  @default(now())
  createdById   String?
  createdBy     User?     @relation("PayrollPaymentCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([payrollId])
  @@index([paidAt])
  @@index([walletId])
}

// HR-created payroll adjustment (advance-independent).
// kind: PREVIOUS_OVERPAYMENT_DEDUCTION | PREVIOUS_UNDERPAYMENT_EARNING | OTHER
// A reason is always required (enforced in the service layer).
model PayrollAdjustment {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollId   String?
  payroll     Payroll?  @relation(fields: [payrollId], references: [id], onDelete: SetNull)
  kind        String
  // DEDUCTION | EARNING — the adjustment's sign. Implied by kind for the
  // PREVIOUS_* kinds; chosen by HR for OTHER.
  direction   String  @default("DEDUCTION")
  // MANUAL = HR-created, applied additively to the payroll's gross.
  // ADVANCE_EDIT = auto-created when a paid advance's amount changed; it
  // itemises the already-embedded previousDebt delta instead of being
  // applied on top of it (which would double-count).
  source      String  @default("MANUAL")
  amountMinor Int
  currency    String    @default("AFN")
  reason      String
  note        String?
  createdById String?
  createdBy   User?     @relation("PayrollAdjustmentCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([employeeId, createdAt])
  @@index([payrollId])
  @@index([kind])
}

// Journal-style accounting entry. Corrections are posted as reversal +
// corrected entry; posted entries are never silently overwritten or deleted.
model AccountingEntry {
  id          String    @id @default(cuid())
  // PAYROLL_APPROVAL | PAYROLL_PAYMENT | PAYROLL_REVERSAL | ADVANCE_PAYMENT | ...
  type        String
  amountMinor Int
  currency    String    @default("AFN")
  description String?
  payrollId   String?
  payroll     Payroll?  @relation(fields: [payrollId], references: [id], onDelete: SetNull)
  cashTransactionId String?
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id], onDelete: SetNull)
  walletId    String?
  wallet      Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)
  expenseId   String?
  expense     Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  reversalOfId String?
  reversalOf  AccountingEntry?  @relation("AccountingReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals   AccountingEntry[] @relation("AccountingReversal")
  postedById  String?
  postedBy    User?     @relation("AccountingEntryPoster", fields: [postedById], references: [id])
  postedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([payrollId])
  @@index([cashTransactionId])
  @@index([walletId])
  @@index([postedAt])
}


model PayrollLine {
  id                  String   @id @default(cuid())
  payrollId           String
  payroll             Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalaryMinor     Int      @default(0)
  currency            String   @default("AFN")
  attendanceDays      Float    @default(0)
  workDays            Int      @default(0)
  overtimeHours       Float    @default(0)
  overtimePayMinor    Int      @default(0)
  allowancesMinor     Int      @default(0)
  bonusesMinor        Int      @default(0)
  deductionsMinor     Int      @default(0)
  grossPayMinor       Int      @default(0)
  expensesPaidMinor   Int      @default(0)
  deductExpenses      Boolean  @default(true)
  amountAlreadyReceivedMinor Int @default(0)
  previousDebtMinor   Int      @default(0)
  // Manual payroll adjustments (Plan-payroll.pdf §1 "Payroll Adjustments"):
  // additive figures inside gross — a deduction lowers what the employee is
  // paid this period, an earning raises it. `previousAdjustments*` itemise
  // the part of previousDebt that comes from advance-edit corrections
  // (source ADVANCE_EDIT): the edited advance is already inside the received
  // total, so those rows explain the figure instead of adding to it.
  adjustmentsDeductedMinor Int @default(0)
  adjustmentsEarnedMinor   Int @default(0)
  previousAdjustmentsDeductedMinor Int @default(0)
  previousAdjustmentsEarnedMinor   Int @default(0)
  advancesDeductedMinor Int     @default(0)
  // Loan repayment auto-deducted from this payroll (Plan-payroll.pdf §1
  // "Loans"). `loanDeductionOverridden` marks an HR-entered value that must
  // survive a recomputation (otherwise the figure is re-proposed fresh).
  loanDeductionMinor  Int      @default(0)
  loanDeductionOverridden Boolean @default(false)
  netPayableMinor     Int      @default(0)
  remainingEmployeeDebtMinor Int @default(0)
  paymentStatus       String   @default("UNPAID")
  paymentMethod       String?
  netPayMinor         Int      @default(0)
  salarySnapshotDate  DateTime?
  createdAt           DateTime @default(now())

  @@index([payrollId])
  @@index([employeeId])
}

// Allocation of an employee cash advance/transaction to a specific payroll,
// so the same received amount is never deducted from earnings twice.
model PayrollAdvanceAllocation {
  id                 String    @id @default(cuid())
  payrollId          String
  payroll            Payroll   @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  cashTransactionId  String
  cashTransaction    CashTransaction @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)
  amountMinor        Int
  createdAt          DateTime  @default(now())

  @@unique([payrollId, cashTransactionId])
  @@index([payrollId])
  @@index([cashTransactionId])
}

// Loan repayment deducted from a payroll (Plan-payroll.pdf §1 "Loans").
// Mirrors PayrollAdvanceAllocation: the row is the record that the deduction
// happened — there is no cash transaction for it, because the salary payment
// itself already paid out the reduced net. Restoring these rows on revert
// gives the loan balances back.
model PayrollLoanAllocation {
  id          String   @id @default(cuid())
  payrollId   String
  payroll     Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amountMinor Int
  createdAt   DateTime @default(now())

  @@unique([payrollId, loanId])
  @@index([payrollId])
  @@index([loanId])
}

// Formal employee loan (Plan-payroll.pdf §1 "Loans"). Goes through the same
// approval workflow as advances: once approved the principal is disbursed as a
// `LOAN` cash transaction (feeding the employee balance like an ADVANCE) and
// `balanceMinor` tracks what is still owed — reduced by payroll auto-deduction
// (PayrollLoanAllocation) or a manual `LOAN_REPAYMENT` cash transaction.
// `monthlyInstallmentMinor` / `dueDate` are an optional repayment schedule;
// `autoDeduct` (default on) lets payroll propose the deduction each period.
model Loan {
  id                    String   @id @default(cuid())
  employeeId            String
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  principalMinor        Int
  balanceMinor          Int
  currency              String   @default("AFN")
  issueDate             DateTime
  dueDate               DateTime?
  monthlyInstallmentMinor Int?
  autoDeduct            Boolean  @default(true)
  // PENDING | ACTIVE | PAID | CANCELLED
  status                String   @default("PENDING")
  note                  String?
  createdById           String?
  createdBy             User?    @relation("LoanCreator", fields: [createdById], references: [id])
  approvalStatus        String   @default("PENDING")
  approvedById          String?
  approvedAt            DateTime?
  approvalNote          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  allocations           PayrollLoanAllocation[]
  repayments            CashTransaction[] @relation("LoanRepayment")

  @@index([employeeId])
  @@index([status])
  @@index([approvalStatus])
}

// Every payroll change records who changed it and when (Plan-payroll.pdf
// §2 action 13). `oldValues` (JSON snapshot) are retained only for Admin
// changes. payrollId/employeeId are plain columns — deliberately not
// relations — so the trail survives an Admin deleting the payroll record
// (§2 action 14).
model PayrollAuditLog {
  id         String   @id @default(cuid())
  payrollId  String?
  employeeId String?
  action     String
  summary    String?
  oldValues  String?
  newValues  String?
  reason     String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([payrollId, createdAt])
  @@index([employeeId, createdAt])
  @@index([userId])
}

// --- HR: Audit trail for important employee changes ---
model EmployeeAuditEvent {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  action        String
  field         String?
  previousValue String?
  newValue      String?
  effectiveDate DateTime?
  reason        String?
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([employeeId, createdAt])
  @@index([action])
}

model Expense {
  id                 String      @id @default(cuid())
  title              String
  description        String?
  category           String
  amount             Float
  paymentMethod      String
  paidTo             String
  paidBy             String
  expenseDate        DateTime
  attachment         String?
  tags               String?
  notes              String?
  currency           String      @default("AFN")
  createdBy          String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  paidById           String?
  paidToId           String?
  paidToContractorId String?
  paidByContractorId String?
  payrollId          String?
  walletId           String?
  deductFromWallet   Boolean     @default(true)
  assetId            String?
  fuelTransactionId  String?
  // Reimbursement: paid back to the employee who fronted the cost.
  reimbursedAt          DateTime?
  reimbursedById        String?
  reimbursementMethod   String?
  reimbursementTransactionId String?
  approvalStatus     String      @default("PENDING")
  approvedById       String?
  approvedAt         DateTime?
  approvalNote       String?
  approver           User?       @relation("ExpenseApprover", fields: [approvedById], references: [id])
  payroll            Payroll?    @relation(fields: [payrollId], references: [id])
  wallet             Wallet?     @relation(fields: [walletId], references: [id])
  reimbursementTransaction CashTransaction? @relation(fields: [reimbursementTransactionId], references: [id], onDelete: SetNull)
  paidByContractor   Contractor? @relation("ExpensePaidByContractor", fields: [paidByContractorId], references: [id])
  paidToContractor   Contractor? @relation("ExpensePaidToContractor", fields: [paidToContractorId], references: [id])
  paidToEmployee     Employee?   @relation("ExpensePaidTo", fields: [paidToId], references: [id])
  paidByEmployee     Employee?   @relation("ExpensePaidBy", fields: [paidById], references: [id])
  creator            User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  asset              Asset?      @relation("ExpenseAsset", fields: [assetId], references: [id], onDelete: SetNull)
  fuelTransaction    FuelTransaction? @relation("FuelTransactionExpense", fields: [fuelTransactionId], references: [id], onDelete: SetNull)
  fuelUsage          FuelUsage[]
  walletTransactions WalletTransaction[]
  accountingEntries  AccountingEntry[]

  @@index([expenseDate])
  @@index([category])
  @@index([createdBy])
  @@index([paidById])
  @@index([paidToId])
  @@index([paidToContractorId])
  @@index([paidByContractorId])
  @@index([paymentMethod])
  @@index([amount])
  @@index([title])
  @@index([paidBy])
  @@index([paidTo])
  @@index([category, expenseDate])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
  @@index([approvalStatus, expenseDate])
  @@index([approvalStatus, category])
  @@index([paidToId, expenseDate])
  @@index([approvalStatus, paidToContractorId, expenseDate])
  @@index([approvalStatus, createdBy, expenseDate])
  @@index([payrollId])
  @@index([walletId])
  @@index([assetId])
  @@index([fuelTransactionId])
  @@index([paidById, reimbursedAt])
}

model Contractor {
  id               String            @id @default(cuid())
  contractorNumber String?           @unique
  contractorName   String
  fatherName       String
  companyName      String?
  phoneNumber      String
  alternativePhone String?
  email            String?
  address          String?
  nationalId       String?
  contractorType   String
  status           String            @default("ACTIVE")
  notes            String?
  createdBy        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  idImageBack      String?
  idImageFront     String?
  // Lifecycle / compliance (Phase 5): reasons recorded for accountability.
  suspendedAt       DateTime?
  suspendedReason   String?
  blacklistedAt     DateTime?
  blacklistedReason String?
  statusChangedById String?
  creator          User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  expensesPaidBy   Expense[]         @relation("ExpensePaidByContractor")
  expensesPaidTo   Expense[]         @relation("ExpensePaidToContractor")
  fuelTransactions FuelTransaction[]
  fuelUsages       FuelUsage[]
  machinery        Machinery[]
  machineryAssignments MachineryAssignment[]
  timesheets       Timesheet[]
  contracts        ContractorContract[]
  claims           ContractorClaim[]
  advances         ContractorAdvance[]
  payments         ContractorPayment[]
  ledgerEntries    ContractorLedgerEntry[]
  contacts         ContractorContact[]
  bankAccounts     ContractorBankAccount[]
  documents        ContractorDocument[]
  paymentAuthorizations PaymentAuthorization[]

  @@index([phoneNumber])
  @@index([nationalId])
  @@index([status])
  @@index([createdBy])
}

model ContractorContract {
  id                    String    @id @default(cuid())
  contractNumber        String    @unique
  contractorId          String
  title                 String
  // Free-text project reference (no Project model exists yet; kept consistent
  // with EmployeeContract.project / Asset.project conventions).
  projectName           String?
  contractType          String    @default("MACHINERY_HIRE")
  value                 Float     @default(0)
  startDate             DateTime
  endDate               DateTime?
  paymentTerms          String?
  retentionPercent      Float     @default(0)
  advanceAllowed        Boolean   @default(true)
  workHoursPerDay       Int       @default(9)
  contractDaysPerMonth  Int       @default(28)
  overtimeRatePercent   Float?
  penaltyTerms          String?
  // Responsibility matrix
  companyProvidesFuel     Boolean @default(false)
  contractorProvidesOperator Boolean @default(true)
  companyHandlesMaintenance Boolean @default(false)
  downtimeChargeable     Boolean @default(true)
  status                String    @default("DRAFT") // DRAFT | ACTIVE | SUSPENDED | COMPLETED | TERMINATED
  notes                 String?
  createdBy             String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  creator               User      @relation("ContractorContractCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  contractor            Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  rates                 ContractRate[]
  variations            ContractVariation[]
  timesheets            Timesheet[]
  claims                ContractorClaim[]
  machineryAssignments  MachineryAssignment[]
  machineryDailyLogs    MachineryDailyLog[]

  @@index([contractorId])
  @@index([status])
  @@index([projectName])
}

model ContractRate {
  id                 String             @id @default(cuid())
  contractId         String
  // Business label, e.g. EXCAVATOR_HOUR, TRIP_LOAD, LABOR_DAY
  label              String
  // HOURLY | DAILY | MONTHLY | UNIT
  rateType           String
  unitLabel          String?
  amount             Float
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  isDefault          Boolean            @default(false)
  notes              String?
  approvedById       String?
  approvedAt         DateTime?
  createdBy          String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  contract           ContractorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  approver           User?              @relation("ContractRateApprover", fields: [approvedById], references: [id])
  creator            User               @relation("ContractRateCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  timesheets         Timesheet[]

  @@index([contractId, label])
  @@index([contractId, isDefault])
}

model ContractVariation {
  id             String             @id @default(cuid())
  contractId     String
  variationNumber String
  description    String
  valueChange    Float              @default(0)
  // Optional rate change embedded in the variation
  rateLabel      String?
  newAmount      Float?
  effectiveFrom  DateTime
  status         String             @default("PENDING") // PENDING | APPROVED | REJECTED
  approvedById   String?
  approvedAt     DateTime?
  createdBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  contract       ContractorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  approver       User?              @relation("ContractVariationApprover", fields: [approvedById], references: [id])
  creator        User               @relation("ContractVariationCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([contractId, status])
}

// ─── Phase 4: Claims, advances, payments, ledger ────────────────────────────

model ContractorClaim {
  id                  String    @id @default(cuid())
  claimNumber         String    @unique
  contractorId        String
  contractId          String
  title               String
  periodStart         DateTime
  periodEnd           DateTime
  grossAmount         Float
  // Snapshot of the contract's retention terms at claim time.
  retentionPercent    Float     @default(0)
  retentionAmount     Float     @default(0)
  deductionsTotal     Float     @default(0)
  advanceRecoveryTotal Float    @default(0)
  netAmount           Float
  paidAmount          Float     @default(0)
  status              String    @default("DRAFT")
  // Approval framework fields (submitted claims appear on the approvals page)
  approvalStatus      String    @default("PENDING")
  approvedById        String?
  approvedAt          DateTime?
  approvalNote        String?
  // Ledger posting marker: liability posted exactly once.
  postedAt            DateTime?
  submittedById       String?
  verifiedById        String?
  financeReviewedById String?
  voidedAt            DateTime?
  notes               String?
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  contractor          Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  contract            ContractorContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  approver            User?      @relation("ContractorClaimApprover", fields: [approvedById], references: [id])
  creator             User       @relation("ContractorClaimCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  lines               ContractorClaimLine[]
  deductions          ContractorDeduction[]
  retentionReleases   RetentionRelease[]
  advanceRecoveries   AdvanceRecovery[]
  allocations         PaymentAllocation[]

  @@index([contractorId])
  @@index([contractId])
  @@index([status])
  @@index([approvalStatus, createdBy])
}

model ContractorClaimLine {
  id          String          @id @default(cuid())
  claimId     String
  sourceType  String          @default("TIMESHEET") // TIMESHEET | MANUAL | VARIATION
  timesheetId String?
  description String
  quantity    Float
  unitLabel   String?
  rateLabel   String?
  // Snapshot of the rate at claim time — later rate changes never rewrite it.
  rateAmount  Float
  amount      Float
  claim       ContractorClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([timesheetId])
}

model ContractorDeduction {
  id          String          @id @default(cuid())
  claimId     String
  type        String          // FUEL | PENALTY | MATERIALS | ACCOMMODATION | FOOD | TRANSPORT | TAX | OTHER
  description String
  amount      Float
  appliedBy   String
  createdAt   DateTime        @default(now())
  claim       ContractorClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model RetentionRelease {
  id          String          @id @default(cuid())
  claimId     String
  amount      Float
  date        DateTime
  reason      String
  releasedBy  String
  createdAt   DateTime        @default(now())
  claim       ContractorClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model ContractorAdvance {
  id               String    @id @default(cuid())
  advanceNumber    String    @unique
  contractorId     String
  contractId       String?
  amount           Float
  date             DateTime
  recoveredAmount  Float     @default(0)
  // Fraction of each future claim's net payable auto-recovered (0-100).
  recoveryPercent  Float?
  status           String    @default("OUTSTANDING") // OUTSTANDING | PARTIALLY_RECOVERED | RECOVERED | WRITTEN_OFF
  walletId         String?
  expenseId        String?
  writtenOffAt     DateTime?
  notes            String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  contractor       Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  recoveries       AdvanceRecovery[]

  @@index([contractorId])
  @@index([status])
}

model AdvanceRecovery {
  id        String            @id @default(cuid())
  advanceId String
  claimId   String
  amount    Float
  date      DateTime
  advance   ContractorAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  claim     ContractorClaim   @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([advanceId])
  @@index([claimId])
}

model ContractorPayment {
  id               String    @id @default(cuid())
  paymentNumber    String    @unique
  contractorId     String
  contractId       String?
  amount           Float
  paymentDate      DateTime
  method           String    @default("CASH") // CASH | BANK_TRANSFER | CHEQUE
  walletId         String?
  authorizedById   String?
  // Link to the Expense row created for the cash-out (D4).
  expenseId        String?
  // Compliance (Phase 5): the authorization that covered this payment and an
  // immutable snapshot of its terms + the contractor's doc status at payment
  // time. SetNull keeps history when an authorization is later revoked.
  paymentAuthorizationId String?
  authorizationSnapshot  Json?
  status           String    @default("COMPLETED") // PENDING | COMPLETED | BOUNCED | REVERSED
  idempotencyKey   String?   @unique
  notes            String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  contractor       Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  authorization    PaymentAuthorization? @relation(fields: [paymentAuthorizationId], references: [id], onDelete: SetNull)
  allocations      PaymentAllocation[]

  @@index([contractorId])
  @@index([status])
}

model PaymentAllocation {
  id        String            @id @default(cuid())
  paymentId String
  claimId   String
  amount    Float
  createdAt DateTime          @default(now())
  payment   ContractorPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  claim     ContractorClaim   @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([claimId])
}

// ── Authorization & compliance (Phase 5) ────────────────────────────────────

model ContractorContact {
  id           String    @id @default(cuid())
  contractorId String
  name         String
  role         String?   // e.g. Site manager, Accountant, Owner
  phone        String
  email        String?
  isPrimary    Boolean   @default(false)
  notes        String?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([phone])
}

model ContractorBankAccount {
  id             String    @id @default(cuid())
  contractorId   String
  accountName    String
  accountNumber  String
  bankName       String
  branch         String?
  isVerified     Boolean   @default(false)
  verifiedById   String?
  verifiedAt     DateTime?
  isDefault      Boolean   @default(false)
  notes          String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  contractor     Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([accountNumber])
}

model ContractorDocument {
  id             String    @id @default(cuid())
  contractorId   String
  docType        String    // NATIONAL_ID | BUSINESS_LICENSE | TAX_CERTIFICATE | INSURANCE | OTHER
  title          String
  documentNumber String?
  issueDate      DateTime?
  // Expired NATIONAL_ID / BUSINESS_LICENSE docs block payments (Phase 5).
  expiryDate     DateTime?
  fileUrl        String?
  notes          String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  contractor     Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([docType])
}

model PaymentAuthorization {
  id                  String    @id @default(cuid())
  authorizationNumber String    @unique
  contractorId        String
  // Free-text receiver (matches how payments record authorizedById today).
  receiverName        String
  validFrom           DateTime
  validTo             DateTime?
  maxAmount           Float?
  revokedAt           DateTime?
  revokedById         String?
  notes               String?
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  contractor          Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  payments            ContractorPayment[]

  @@index([contractorId])
  @@index([validFrom, validTo])
}

model ContractorLedgerEntry {
  id                String    @id @default(cuid())
  contractorId      String
  contractId        String?
  claimId           String?
  paymentId         String?
  advanceId         String?
  retentionReleaseId String?
  // Signed: positive increases what the company owes the contractor.
  type              String    // CLAIM_POSTED | CLAIM_REVERSAL | RETENTION_HELD | RETENTION_RELEASED | ADVANCE_DISBURSED | ADVANCE_RECOVERY | PAYMENT | PAYMENT_REVERSAL | WRITE_OFF
  amount            Float
  // Derived from the ledger sum inside the posting transaction (never trusted standalone).
  balanceAfter      Float
  reference         String?
  occurredAt        DateTime
  createdBy         String
  createdAt         DateTime  @default(now())
  contractor        Contractor @relation(fields: [contractorId], references: [id], onDelete: Restrict)

  @@index([contractorId, occurredAt])
  @@index([claimId])
  @@index([paymentId])
  @@index([advanceId])
}

model Sequence {
  name  String @id
  value Int    @default(1)
}

model Timesheet {
  id               String         @id @default(cuid())
  contractorId     String
  machineryId      String?
  machineryRateId  String?
  // Contract/rate snapshot stamped at approval time so later rate changes
  // never rewrite what this work was billed at (Phase 2).
  contractId       String?
  contractRateId   String?
  rateLabel        String?
  rateAmount       Float?
  operatorName     String?
  workSite         String?
  date             DateTime
  startTime        String?
  lunchStart       String?
  lunchEnd         String?
  endTime          String?
  totalHours       Float          @default(0)
  overtimeHours    Float          @default(0)
  approvedBy       String?
  approvedAt       DateTime?
  approvalStatus   String         @default("PENDING")
  approvedById     String?
  approvalNote     String?
  notes            String?
  createdBy        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  approvalApprover User?          @relation("TimesheetApprovalApprover", fields: [approvedById], references: [id])
  approver         User?          @relation("TimesheetApprovedBy", fields: [approvedBy], references: [id])
  creator          User           @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  machineryRate    MachineryRate? @relation(fields: [machineryRateId], references: [id])
  machinery        Machinery?     @relation(fields: [machineryId], references: [id])
  contract         ContractorContract? @relation(fields: [contractId], references: [id])
  contractRate     ContractRate?  @relation(fields: [contractRateId], references: [id])
  contractor       Contractor     @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId, date])
  @@index([machineryId])
  @@index([machineryId, date])
  @@index([contractId])
  @@index([approvedBy])
  @@index([createdBy])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
  @@index([approvalStatus, contractorId, date])
  @@index([approvalStatus, machineryId, date])
  @@index([approvalStatus, createdBy])
}

model FuelUsage {
  id                String           @id @default(cuid())
  contractorId      String
  machineryId       String?
  fuelType          String
  quantity          Float
  unitPrice         Float
  totalCost         Float
  date              DateTime
  fuelStation       String?
  receiptAttachment String?
  linkedExpenseId   String?
  fuelTransactionId String?
  billable          Boolean         @default(false)
  notes             String?
  createdBy         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  approvalStatus    String           @default("PENDING")
  approvedById      String?
  approvedAt        DateTime?
  approvalNote      String?
  approver          User?            @relation("FuelUsageApprover", fields: [approvedById], references: [id])
  creator           User             @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  fuelTransaction   FuelTransaction? @relation(fields: [fuelTransactionId], references: [id])
  linkedExpense     Expense?         @relation(fields: [linkedExpenseId], references: [id])
  machinery         Machinery?       @relation(fields: [machineryId], references: [id])
  contractor        Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId, date])
  @@index([machineryId])
  @@index([machineryId, date])
  @@index([linkedExpenseId])
  @@index([fuelTransactionId])
  @@index([createdBy])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
  @@index([approvalStatus, contractorId, date])
  @@index([approvalStatus, machineryId, date])
  @@index([approvalStatus, createdBy])
}

model Machinery {
  id                    String            @id @default(cuid())
  machineryName         String
  machineryType         String
  plateNumber           String?
  model                 String?
  driverName            String?
  driverFatherName      String?
  driverPhoneNumber     String?
  driverNationalId      String?
  driverIdImageFront    String?
  driverIdImageBack     String?
  status                String            @default("OPERATIONAL")
  assignedContractorId  String
  fuelType              String            @default("DIESEL")
  hourlyConsumptionRate Float             @default(0)
  hourlyRate            Float             @default(0)
  dailyRate             Float             @default(0)
  monthlyRate           Float             @default(0)
  contractDaysPerMonth  Int               @default(28)
  workHoursPerDay       Int               @default(9)
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  // Ownership & commercial terms (Phase 3)
  ownershipType         String            @default("COMPANY") // COMPANY | CONTRACTOR_OWNED | RENTED | LEASED
  rentalRate            Float?
  rentalRateType        String?           // DAILY | MONTHLY
  rentalStartDate       DateTime?
  rentalEndDate         DateTime?
  // Daily-log meter jump (closing - opening) above this value flags the
  // record for review; null = never flag.
  meterJumpThreshold    Float?
  createdBy             String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  fuelTransactions      FuelTransaction[]
  fuelUsages            FuelUsage[]
  creator               User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  assignedContractor    Contractor        @relation(fields: [assignedContractorId], references: [id], onDelete: Cascade)
  machineryRates        MachineryRate[]
  timesheets            Timesheet[]
  assignments           MachineryAssignment[]
  dailyLogs             MachineryDailyLog[]
  downtimes             DowntimeRecord[]

  @@index([assignedContractorId])
  @@index([plateNumber])
  @@index([status])
  @@index([createdBy])
}

model MachineryRate {
  id                   String      @id @default(cuid())
  machineryId          String
  rateName             String
  monthlyRate          Float       @default(0)
  dailyRate            Float       @default(0)
  hourlyRate           Float       @default(0)
  contractDaysPerMonth Int         @default(28)
  workHoursPerDay      Int         @default(9)
  isDefault            Boolean     @default(false)
  createdBy            String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  creator              User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  machinery            Machinery   @relation(fields: [machineryId], references: [id], onDelete: Cascade)
  timesheets           Timesheet[]

  @@index([machineryId])
}

// Transfer history: one row per assignment of a machine to a contractor.
// Machinery.assignedContractorId is a denormalized pointer to the active
// assignment, maintained by machinery-assignment.service in the same
// transaction as the assignment change.
model MachineryAssignment {
  id            String             @id @default(cuid())
  machineryId   String
  contractorId  String
  contractId    String?
  projectName   String?
  startDate     DateTime
  endDate       DateTime?
  // Free-text name of the person who handed the machine over (may differ
  // from the acting user account recorded in createdBy).
  transferredBy String
  notes         String?
  createdBy     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  machinery     Machinery          @relation(fields: [machineryId], references: [id], onDelete: Cascade)
  contractor    Contractor         @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  contract      ContractorContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([machineryId, startDate])
  @@index([contractorId])
  @@index([contractId])
}

// One operating record per machine per day (unique on machineryId+date).
// closingMeter must exceed openingMeter; a day's meter jump above
// Machinery.meterJumpThreshold flags the row for review.
model MachineryDailyLog {
  id             String            @id @default(cuid())
  date           DateTime
  machineryId    String
  contractId     String?
  openingMeter   Float
  closingMeter   Float
  normalHours    Float             @default(0)
  overtimeHours  Float             @default(0)
  idleHours      Float             @default(0)
  breakdownHours Float             @default(0)
  weather        String?
  delayReason    String?
  operator       String?
  flagged        Boolean           @default(false)
  flagReason     String?
  // Display name of the person who recorded the log (defaults to the acting user).
  loggedBy       String
  createdBy      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  machinery      Machinery         @relation(fields: [machineryId], references: [id], onDelete: Cascade)
  contract       ContractorContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@unique([machineryId, date])
  @@index([machineryId, date])
  @@index([contractId])
  @@index([flagged])
}

model DowntimeRecord {
  id          String    @id @default(cuid())
  machineryId String
  start       DateTime
  end         DateTime?
  reason      String
  chargeable  Boolean   @default(false)
  notes       String?
  // Display name of the person who recorded the record.
  loggedBy    String
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  machinery   Machinery @relation(fields: [machineryId], references: [id], onDelete: Cascade)

  @@index([machineryId, start])
}

model Attendance {
  id             String    @id @default(cuid())
  employeeId     String
  date           DateTime
  status         String
  notes          String?
  overtimeHours  Float     @default(0)
  checkInTime    DateTime?
  checkOutTime   DateTime?
  workedHours    Float     @default(0)
  createdBy      String
  createdAt      DateTime  @default(now())
  approvalStatus String    @default("PENDING")
  approvedById   String?
  approvedAt     DateTime?
  approvalNote   String?
  approver       User?     @relation("AttendanceApprover", fields: [approvedById], references: [id])
  creator        User      @relation(fields: [createdBy], references: [id])
  employee       Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([createdBy])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
}

model EmployeeCashAccount {
  id             String   @id @default(cuid())
  employeeId     String   @unique
  currentBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Employee @relation(fields: [employeeId], references: [id])
}

model CashTransaction {
  id              String    @id @default(cuid())
  employeeId      String
  type            String
  amount          Float
  note            String?
  referenceNumber String?
  // Optional due date for advances; overdue advances are only warned about.
  dueDate         DateTime?
  // CASH | BANK_TRANSFER | COMPANY_WALLET | ... (set when the advance is paid)
  paymentMethod   String?
  paidAt          DateTime?
  editedById      String?
  editedAt        DateTime?
  createdBy       String
  approvalStatus  String   @default("PENDING")
  approvedById    String?
  approvedAt      DateTime?
  approvalNote    String?
  payrollId       String?
  walletId        String?
  // Set on manual LOAN_REPAYMENT rows so the loan balance can be reduced
  // when the transaction is approved.
  loanId          String?
  createdAt       DateTime  @default(now())
  approver        User?     @relation("CashTransactionApprover", fields: [approvedById], references: [id])
  creator         User      @relation(fields: [createdBy], references: [id])
  employee        Employee  @relation(fields: [employeeId], references: [id])
  wallet          Wallet?   @relation(fields: [walletId], references: [id])
  loan            Loan?     @relation("LoanRepayment", fields: [loanId], references: [id])
  payrollAllocations PayrollAdvanceAllocation[]
  accountingEntries  AccountingEntry[]
  reimbursements     Expense[]

  @@index([employeeId])
  @@index([type])
  @@index([createdBy])
  @@index([createdAt])
  @@index([dueDate])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
  @@index([payrollId])
  @@index([walletId])
}

model Wallet {
  id               String             @id @default(cuid())
  name             String
  type             String             @default("CASH")
  currency         String             @default("AFN")
  balance          Float              @default(0)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  transactions     WalletTransaction[]
  cashTransactions CashTransaction[]
  payrolls         Payroll[]
  expenses         Expense[]
  payrollPayments  PayrollPayment[]
  accountingEntries AccountingEntry[]
  employees        WalletEmployee[]
  users            WalletUser[]

  @@index([isActive])
}

model WalletEmployee {
  id         String   @id @default(cuid())
  walletId   String
  employeeId String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([walletId, employeeId])
  @@index([walletId])
  @@index([employeeId])
}

model WalletUser {
  id        String   @id @default(cuid())
  walletId  String
  userId    String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([walletId, userId])
  @@index([walletId])
  @@index([userId])
}

model WalletTransaction {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      String
  amount    Float
  note      String?
  payrollId String?
  expenseId String?
  createdBy String
  createdAt DateTime @default(now())
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([type])
  @@index([payrollId])
  @@index([expenseId])
}

model Transfer {
  id              String    @id @default(cuid())
  fromEmployeeId  String
  toEmployeeId    String
  amount          Float
  note            String?
  referenceNumber String?
  createdBy       String
  createdAt       DateTime  @default(now())
  approvalStatus  String    @default("PENDING")
  approvedById    String?
  approvedAt      DateTime?
  approvalNote    String?
  approver        User?     @relation("TransferApprover", fields: [approvedById], references: [id])
  creator         User      @relation(fields: [createdBy], references: [id])
  toEmployee      Employee  @relation("TransferTo", fields: [toEmployeeId], references: [id])
  fromEmployee    Employee  @relation("TransferFrom", fields: [fromEmployeeId], references: [id])

  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@index([createdBy])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
}

model AppSettings {
  id                String    @id @default("default")
  companyName       String    @default("YakhshiLedger")
  companyLogo       String?
  address           String?
  phone             String?
  email             String?
  website           String?
  taxId             String?
  allowSignup       Boolean   @default(false)
  lastSyncTimestamp DateTime?
  updatedAt         DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Asset {
  id                          String              @id @default(cuid())
  name                        String
  category                    String
  purchaseDate                DateTime
  purchasePrice               Float
  currentValue                Float
  quantity                    Int                 @default(1)
  serialNumber                String?
  plateNumber                 String?
  assignedToId                String?
  status                      String              @default("ACTIVE")
  notes                       String?
  images                      String?
  fuelType                    String?
  fuelCapacity                Float?
  fuelLocation                String?
  isMainContainer             Boolean             @default(false)
  createdBy                   String
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  creator                     User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  assignedTo                  Employee?           @relation(fields: [assignedToId], references: [id])
  assetLogs                   AssetLog[]
  fuelDestinationTransactions FuelTransaction[]   @relation("FuelTransactionDestination")
  fuelContainerTransactions   FuelTransaction[]   @relation("FuelTransactionContainer")
  fuelTransactions            FuelTransaction[]   @relation("FuelIssuedToAsset")
  maintenanceRecords          MaintenanceRecord[]
  expenses                    Expense[]           @relation("ExpenseAsset")

  @@index([assignedToId])
  @@index([category])
  @@index([status])
  @@index([serialNumber])
  @@index([plateNumber])
  @@index([createdBy])
}

model FuelTransaction {
  id                     String      @id @default(cuid())
  type                   String
  fuelType               String
  quantity               Float
  unitPrice              Float?
  totalCost              Float?
  supplier               String?
  assetId                String?
  containerId            String?
  destinationContainerId String?
  contractorId           String?
  machineryId            String?
  issuedToName           String?
  notes                  String?
  date                   DateTime    @default(now())
  createdBy              String
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  creator                User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  machinery              Machinery?  @relation(fields: [machineryId], references: [id])
  contractor             Contractor? @relation(fields: [contractorId], references: [id])
  destinationContainer   Asset?      @relation("FuelTransactionDestination", fields: [destinationContainerId], references: [id])
  container              Asset?      @relation("FuelTransactionContainer", fields: [containerId], references: [id])
  asset                  Asset?      @relation("FuelIssuedToAsset", fields: [assetId], references: [id])
  fuelUsages             FuelUsage[]
  expenses               Expense[]      @relation("FuelTransactionExpense")

  @@index([type])
  @@index([fuelType])
  @@index([assetId])
  @@index([containerId])
  @@index([contractorId])
  @@index([machineryId])
  @@index([date])
  @@index([createdBy])
}

model MaintenanceRecord {
  id              String    @id @default(cuid())
  assetId         String
  serviceDate     DateTime
  serviceType     String
  cost            Float
  description     String?
  vendor          String?
  nextServiceDate DateTime?
  notes           String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  creator         User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([serviceDate])
  @@index([createdBy])
}

model AssetLog {
  id               String    @id @default(cuid())
  assetId          String
  date             DateTime
  startTime        String?
  endTime          String?
  operatorId       String?
  startOdometer    Float?
  endOdometer      Float?
  distanceTraveled Float?
  engineHoursStart Float?
  engineHoursEnd   Float?
  engineHoursUsed  Float?
  fuelConsumed     Float?
  workSite         String?
  project          String?
  conditions       String?
  issues           String?
  status           String    @default("PENDING")
  approvedById     String?
  approvedAt       DateTime?
  approvalStatus   String    @default("PENDING")
  approvalNote     String?
  remarks          String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  approvedBy       User?     @relation("ApprovedByUser", fields: [approvedById], references: [id])
  creator          User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  operator         Employee? @relation(fields: [operatorId], references: [id])
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([operatorId])
  @@index([date])
  @@index([status])
  @@index([approvedById])
  @@index([createdBy])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
}

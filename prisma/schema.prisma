generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("USER")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses        Expense[]
  auditLogs       AuditLog[]
  employees       Employee[]
  contractors     Contractor[]
  timesheets      Timesheet[]
  fuelUsages      FuelUsage[]
  machinery       Machinery[]
  cashTransactions CashTransaction[]
  transfers         Transfer[]
  assets            Asset[]
  fuelTransactions  FuelTransaction[]
  maintenanceRecords MaintenanceRecord[]
  assetLogs         AssetLog[]
  approvedAssetLogs AssetLog[] @relation("ApprovedByUser")
  attendanceRecords Attendance[]

  userPermissions UserPermission[]
  timesheetApprovals  Timesheet[] @relation("TimesheetApprovedBy")
  machineryRates      MachineryRate[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  description String?
  module      String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions  UserPermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
}

model Employee {
  id                    String          @id @default(cuid())
  fullName              String
  fatherName            String
  gender                String          @default("male")
  dateOfBirth           DateTime?
  phoneNumber           String
  email                 String?
  address               String?
  nationalId            String?
  jobTitle              String
  department            String
  employmentType        String          @default("FULL_TIME")
  salary                Float           @default(0)
  hireDate              DateTime
  status                String          @default("ACTIVE")
  quitingDate           DateTime?
  idImageFront          String?
  idImageBack           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdBy             String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  creator               User            @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  expensesPaidBy        Expense[]      @relation("ExpensePaidBy")
  expensesPaidTo        Expense[]      @relation("ExpensePaidTo")

  cashAccount           EmployeeCashAccount?
  cashTransactions      CashTransaction[]

  transfersFrom         Transfer[] @relation("TransferFrom")
  transfersTo           Transfer[] @relation("TransferTo")

  assignedAssets        Asset[]
  assetOperatorLogs     AssetLog[]
  attendanceRecords     Attendance[]

  @@index([phoneNumber])
  @@index([email])
  @@index([nationalId])
  @@index([department])
  @@index([status])
  @@index([createdBy])
}

model Expense {
  id             String        @id @default(cuid())
  title          String
  description    String?
  category       String
  amount         Float
  paymentMethod  String
  paidTo         String
  paidBy         String
  expenseDate    DateTime
  attachment     String?
  tags           String?
  notes          String?
  currency       String        @default("AFN")
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  paidById       String?
  paidToId       String?

  paidToContractorId String?
  paidByContractorId String?

  creator        User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  paidByEmployee Employee?     @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paidToEmployee Employee?     @relation("ExpensePaidTo", fields: [paidToId], references: [id], onDelete: SetNull)
  paidToContractor Contractor? @relation("ExpensePaidToContractor", fields: [paidToContractorId], references: [id], onDelete: SetNull)
  paidByContractor Contractor? @relation("ExpensePaidByContractor", fields: [paidByContractorId], references: [id], onDelete: SetNull)

  fuelUsage      FuelUsage[]

  @@index([expenseDate])
  @@index([category])
  @@index([createdBy])
  @@index([paidById])
  @@index([paidToId])
  @@index([paidToContractorId])
  @@index([paidByContractorId])
}

model Contractor {
  id                  String          @id @default(cuid())
  contractorName      String
  fatherName          String
  companyName         String?
  phoneNumber         String
  alternativePhone    String?
  email               String?
  address             String?
  nationalId          String?
  contractorType      String
  status              String          @default("ACTIVE")
  notes               String?
  createdBy           String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  creator             User            @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  expensesPaidTo      Expense[]        @relation("ExpensePaidToContractor")
  expensesPaidBy      Expense[]        @relation("ExpensePaidByContractor")
  timesheets          Timesheet[]
  fuelUsages          FuelUsage[]
  machinery           Machinery[]
  fuelTransactions    FuelTransaction[]

  @@index([phoneNumber])
  @@index([nationalId])
  @@index([status])
  @@index([createdBy])
}

model Timesheet {
  id              String   @id @default(cuid())
  contractorId    String
  machineryId     String?
  machineryRateId String?
  operatorName    String?
  workSite        String?
  date            DateTime
  startTime       String?
  lunchStart      String?
  lunchEnd        String?
  endTime         String?
  totalHours      Float    @default(0)
  overtimeHours   Float    @default(0)
  approvedBy      String?
  approvedAt      DateTime?
  notes           String?
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contractor      Contractor        @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  machinery       Machinery?        @relation(fields: [machineryId], references: [id], onDelete: SetNull)
  machineryRate   MachineryRate?    @relation(fields: [machineryRateId], references: [id], onDelete: SetNull)
  creator         User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  approver        User?             @relation("TimesheetApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([contractorId, date])
  @@index([machineryId])
  @@index([machineryId, date])
  @@index([approvedBy])
  @@index([createdBy])
}

model FuelUsage {
  id              String    @id @default(cuid())
  contractorId    String
  machineryId     String?
  fuelType        String
  quantity        Float
  unitPrice       Float
  totalCost       Float
  date            DateTime
  fuelStation     String?
  receiptAttachment String?
  linkedExpenseId String?
  fuelTransactionId String?
  notes           String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contractor      Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  machinery       Machinery?       @relation(fields: [machineryId], references: [id], onDelete: SetNull)
  linkedExpense   Expense?         @relation(fields: [linkedExpenseId], references: [id], onDelete: SetNull)
  fuelTransaction FuelTransaction? @relation(fields: [fuelTransactionId], references: [id], onDelete: SetNull)
  creator         User             @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([contractorId, date])
  @@index([machineryId])
  @@index([machineryId, date])
  @@index([linkedExpenseId])
  @@index([fuelTransactionId])
  @@index([createdBy])
}

model Machinery {
  id                    String          @id @default(cuid())
  machineryName         String
  machineryType         String
  plateNumber           String?
  model                 String?
  driverName            String?
  status                String          @default("OPERATIONAL")
  assignedContractorId  String
  fuelType              String          @default("DIESEL")
  hourlyConsumptionRate Float           @default(0)
  hourlyRate            Float           @default(0)
  dailyRate             Float           @default(0)
  monthlyRate           Float           @default(0)
  contractDaysPerMonth  Int             @default(28)
  workHoursPerDay       Int             @default(9)
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  createdBy             String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  assignedContractor    Contractor      @relation(fields: [assignedContractorId], references: [id], onDelete: Cascade)
  machineryRates        MachineryRate[]
  timesheets            Timesheet[]
  fuelUsages            FuelUsage[]
  fuelTransactions      FuelTransaction[]
  creator               User            @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([assignedContractorId])
  @@index([plateNumber])
  @@index([status])
  @@index([createdBy])
}

model MachineryRate {
  id                    String    @id @default(cuid())
  machineryId           String
  rateName              String
  monthlyRate           Float     @default(0)
  dailyRate             Float     @default(0)
  hourlyRate            Float     @default(0)
  contractDaysPerMonth  Int       @default(28)
  workHoursPerDay       Int       @default(9)
  isDefault             Boolean   @default(false)
  createdBy             String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  machinery             Machinery  @relation(fields: [machineryId], references: [id], onDelete: Cascade)
  creator               User       @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  timesheets            Timesheet[]

  @@index([machineryId])
}

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  employee      Employee @relation(fields: [employeeId], references: [id])
  date        DateTime
  status      String
  notes       String?
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([createdBy])
}

model EmployeeCashAccount {
  id              String   @id @default(cuid())

  employeeId      String   @unique
  employee        Employee @relation(fields: [employeeId], references: [id])

  currentBalance  Float    @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CashTransaction {
  id              String             @id @default(cuid())

  employeeId      String
  employee        Employee           @relation(fields: [employeeId], references: [id])

  type            String

  amount          Float

  note            String?
  referenceNumber String?

  createdById     String
  creator         User               @relation(fields: [createdById], references: [id])

  createdAt       DateTime           @default(now())

  @@index([employeeId])
  @@index([type])
  @@index([createdById])
  @@index([createdAt])
}

model Transfer {
  id              String   @id @default(cuid())

  fromEmployeeId  String
  toEmployeeId    String
  amount          Float
  note            String?
  referenceNumber String?

  createdById     String
  createdAt       DateTime @default(now())

  fromEmployee    Employee @relation("TransferFrom", fields: [fromEmployeeId], references: [id])
  toEmployee      Employee @relation("TransferTo", fields: [toEmployeeId], references: [id])
  creator         User     @relation(fields: [createdById], references: [id])

  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@index([createdById])
}

model AppSettings {
  id                String    @id @default("default")
  companyName       String    @default("YakhshiLedger")
  companyLogo       String?
  address           String?
  phone             String?
  email             String?
  website           String?
  taxId             String?
  allowSignup       Boolean   @default(false)
  lastSyncTimestamp DateTime?
  updatedAt         DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  userId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Asset {
  id            String        @id @default(cuid())
  name          String
  category      String
  purchaseDate  DateTime
  purchasePrice Float
  currentValue  Float
  quantity      Int           @default(1)
  serialNumber  String?
  plateNumber   String?
  assignedToId  String?
  assignedTo    Employee?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  status        String        @default("ACTIVE")
  notes         String?
  images        String?
  fuelType      String?
  fuelCapacity  Float?
  fuelLocation  String?
  isMainContainer Boolean   @default(false)
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  creator            User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  fuelTransactions   FuelTransaction[]  @relation("FuelIssuedToAsset")
  fuelContainerTransactions  FuelTransaction[] @relation("FuelTransactionContainer")
  fuelDestinationTransactions FuelTransaction[] @relation("FuelTransactionDestination")
  maintenanceRecords MaintenanceRecord[]
  assetLogs         AssetLog[]

  @@index([assignedToId])
  @@index([category])
  @@index([status])
  @@index([serialNumber])
  @@index([plateNumber])
  @@index([createdBy])
}

model FuelTransaction {
  id                     String              @id @default(cuid())
  type                   String
  fuelType               String
  quantity               Float
  unitPrice              Float?
  totalCost              Float?
  supplier               String?
  assetId                String?
  asset                  Asset?              @relation("FuelIssuedToAsset", fields: [assetId], references: [id], onDelete: SetNull)
  containerId            String?
  container              Asset?              @relation("FuelTransactionContainer", fields: [containerId], references: [id], onDelete: SetNull)
  destinationContainerId String?
  destinationContainer   Asset?              @relation("FuelTransactionDestination", fields: [destinationContainerId], references: [id], onDelete: SetNull)
  contractorId           String?
  contractor             Contractor?         @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  machineryId            String?
  machinery              Machinery?          @relation(fields: [machineryId], references: [id], onDelete: SetNull)
  issuedToName           String?
  notes                  String?
  date                   DateTime            @default(now())
  createdBy              String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  creator      User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  fuelUsages   FuelUsage[]

  @@index([type])
  @@index([fuelType])
  @@index([assetId])
  @@index([containerId])
  @@index([contractorId])
  @@index([machineryId])
  @@index([date])
  @@index([createdBy])
}

model MaintenanceRecord {
  id              String          @id @default(cuid())
  assetId         String
  asset           Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  serviceDate     DateTime
  serviceType     String
  cost            Float
  description     String?
  vendor          String?
  nextServiceDate DateTime?
  notes           String?
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([serviceDate])
  @@index([createdBy])
}

model AssetLog {
  id               String    @id @default(cuid())
  assetId          String
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date             DateTime
  startTime        String?
  endTime          String?
  operatorId       String?
  operator         Employee? @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  startOdometer    Float?
  endOdometer      Float?
  distanceTraveled Float?
  engineHoursStart Float?
  engineHoursEnd   Float?
  engineHoursUsed  Float?
  fuelConsumed     Float?
  workSite         String?
  project          String?
  conditions       String?
  issues           String?
  status           String    @default("PENDING")
  approvedById     String?
  approvedAt       DateTime?
  remarks          String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  creator  User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  approvedBy User?  @relation("ApprovedByUser", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([assetId])
  @@index([operatorId])
  @@index([date])
  @@index([status])
  @@index([approvedById])
  @@index([createdBy])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                         String              @id @default(cuid())
  email                      String              @unique
  name                       String
  password                   String
  role                       String              @default("USER")
  avatar                     String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  assets                     Asset[]
  approvedAssetLogs          AssetLog[]          @relation("ApprovedByUser")
  assetLogs                  AssetLog[]
  attendanceApprovals        Attendance[]        @relation("AttendanceApprover")
  attendanceRecords          Attendance[]
  auditLogs                  AuditLog[]
  cashTransactionApprovals   CashTransaction[]   @relation("CashTransactionApprover")
  cashTransactions           CashTransaction[]
  contractors                Contractor[]
  employees                  Employee[]
  expenseApprovals           Expense[]           @relation("ExpenseApprover")
  expenses                   Expense[]
  fuelTransactions           FuelTransaction[]
  fuelUsageApprovals         FuelUsage[]         @relation("FuelUsageApprover")
  fuelUsages                 FuelUsage[]
  machinery                  Machinery[]
  machineryRates             MachineryRate[]
  maintenanceRecords         MaintenanceRecord[]
  recordAccesses             RecordAccess[]
  timesheetApprovalApprovals Timesheet[]         @relation("TimesheetApprovalApprover")
  timesheetApprovals         Timesheet[]         @relation("TimesheetApprovedBy")
  timesheets                 Timesheet[]
  transferApprovals          Transfer[]          @relation("TransferApprover")
  transfers                  Transfer[]
  userPermissions            UserPermission[]
}

model RecordAccess {
  id         String   @id @default(cuid())
  entity     String
  entityId   String
  userId     String
  accessType String   @default("view")
  grantedBy  String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entity, entityId, userId])
  @@index([entity, entityId])
  @@index([userId])
  @@index([entity, userId])
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  label           String
  description     String?
  module          String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Employee {
  id                    String               @id @default(cuid())
  fullName              String
  fatherName            String
  gender                String               @default("male")
  dateOfBirth           DateTime?
  phoneNumber           String
  email                 String?
  address               String?
  nationalId            String?
  jobTitle              String
  department            String
  employmentType        String               @default("FULL_TIME")
  salary                Float                @default(0)
  workHoursPerDay       Int                  @default(9)
  overtimeRate          Float                @default(1.25)
  hireDate              DateTime
  status                String               @default("ACTIVE")
  quitingDate           DateTime?
  idImageFront          String?
  idImageBack           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdBy             String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  assignedAssets        Asset[]
  assetOperatorLogs     AssetLog[]
  attendanceRecords     Attendance[]
  cashTransactions      CashTransaction[]
  creator               User                 @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  cashAccount           EmployeeCashAccount?
  expensesPaidTo        Expense[]            @relation("ExpensePaidTo")
  expensesPaidBy        Expense[]            @relation("ExpensePaidBy")
  transfersTo           Transfer[]           @relation("TransferTo")
  transfersFrom         Transfer[]           @relation("TransferFrom")

  @@index([phoneNumber])
  @@index([email])
  @@index([nationalId])
  @@index([department])
  @@index([status])
  @@index([createdBy])
}

model Expense {
  id                 String      @id @default(cuid())
  title              String
  description        String?
  category           String
  amount             Float
  paymentMethod      String
  paidTo             String
  paidBy             String
  expenseDate        DateTime
  attachment         String?
  tags               String?
  notes              String?
  currency           String      @default("AFN")
  createdBy          String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  paidById           String?
  paidToId           String?
  paidToContractorId String?
  paidByContractorId String?
  approvalStatus     String      @default("PENDING")
  approvedById       String?
  approvedAt         DateTime?
  approvalNote       String?
  approver           User?       @relation("ExpenseApprover", fields: [approvedById], references: [id])
  paidByContractor   Contractor? @relation("ExpensePaidByContractor", fields: [paidByContractorId], references: [id])
  paidToContractor   Contractor? @relation("ExpensePaidToContractor", fields: [paidToContractorId], references: [id])
  paidToEmployee     Employee?   @relation("ExpensePaidTo", fields: [paidToId], references: [id])
  paidByEmployee     Employee?   @relation("ExpensePaidBy", fields: [paidById], references: [id])
  creator            User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  fuelUsage          FuelUsage[]

  @@index([expenseDate])
  @@index([category])
  @@index([createdBy])
  @@index([paidById])
  @@index([paidToId])
  @@index([paidToContractorId])
  @@index([paidByContractorId])
  @@index([paymentMethod])
  @@index([amount])
  @@index([title])
  @@index([paidBy])
  @@index([paidTo])
  @@index([category, expenseDate])
  @@index([approvalStatus])
}

model Contractor {
  id               String            @id @default(cuid())
  contractorName   String
  fatherName       String
  companyName      String?
  phoneNumber      String
  alternativePhone String?
  email            String?
  address          String?
  nationalId       String?
  contractorType   String
  status           String            @default("ACTIVE")
  notes            String?
  createdBy        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  idImageBack      String?
  idImageFront     String?
  creator          User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  expensesPaidBy   Expense[]         @relation("ExpensePaidByContractor")
  expensesPaidTo   Expense[]         @relation("ExpensePaidToContractor")
  fuelTransactions FuelTransaction[]
  fuelUsages       FuelUsage[]
  machinery        Machinery[]
  timesheets       Timesheet[]

  @@index([phoneNumber])
  @@index([nationalId])
  @@index([status])
  @@index([createdBy])
}

model Timesheet {
  id               String         @id @default(cuid())
  contractorId     String
  machineryId      String?
  machineryRateId  String?
  operatorName     String?
  workSite         String?
  date             DateTime
  startTime        String?
  lunchStart       String?
  lunchEnd         String?
  endTime          String?
  totalHours       Float          @default(0)
  overtimeHours    Float          @default(0)
  approvedBy       String?
  approvedAt       DateTime?
  approvalStatus   String         @default("PENDING")
  approvedById     String?
  approvalNote     String?
  notes            String?
  createdBy        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  approvalApprover User?          @relation("TimesheetApprovalApprover", fields: [approvedById], references: [id])
  approver         User?          @relation("TimesheetApprovedBy", fields: [approvedBy], references: [id])
  creator          User           @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  machineryRate    MachineryRate? @relation(fields: [machineryRateId], references: [id])
  machinery        Machinery?     @relation(fields: [machineryId], references: [id])
  contractor       Contractor     @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId, date])
  @@index([machineryId])
  @@index([machineryId, date])
  @@index([approvedBy])
  @@index([createdBy])
  @@index([approvalStatus])
}

model FuelUsage {
  id                String           @id @default(cuid())
  contractorId      String
  machineryId       String?
  fuelType          String
  quantity          Float
  unitPrice         Float
  totalCost         Float
  date              DateTime
  fuelStation       String?
  receiptAttachment String?
  linkedExpenseId   String?
  fuelTransactionId String?
  notes             String?
  createdBy         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  approvalStatus    String           @default("PENDING")
  approvedById      String?
  approvedAt        DateTime?
  approvalNote      String?
  approver          User?            @relation("FuelUsageApprover", fields: [approvedById], references: [id])
  creator           User             @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  fuelTransaction   FuelTransaction? @relation(fields: [fuelTransactionId], references: [id])
  linkedExpense     Expense?         @relation(fields: [linkedExpenseId], references: [id])
  machinery         Machinery?       @relation(fields: [machineryId], references: [id])
  contractor        Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId, date])
  @@index([machineryId])
  @@index([machineryId, date])
  @@index([linkedExpenseId])
  @@index([fuelTransactionId])
  @@index([createdBy])
  @@index([approvalStatus])
}

  model Machinery {
  id                    String            @id @default(cuid())
  machineryName         String
  machineryType         String
  plateNumber           String?
  model                 String?
  driverName            String?
  driverFatherName      String?
  driverPhoneNumber     String?
  driverNationalId      String?
  driverIdImageFront    String?
  driverIdImageBack     String?
  status                String            @default("OPERATIONAL")
  assignedContractorId  String
  fuelType              String            @default("DIESEL")
  hourlyConsumptionRate Float             @default(0)
  hourlyRate            Float             @default(0)
  dailyRate             Float             @default(0)
  monthlyRate           Float             @default(0)
  contractDaysPerMonth  Int               @default(28)
  workHoursPerDay       Int               @default(9)
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  createdBy             String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  fuelTransactions      FuelTransaction[]
  fuelUsages            FuelUsage[]
  creator               User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  assignedContractor    Contractor        @relation(fields: [assignedContractorId], references: [id], onDelete: Cascade)
  machineryRates        MachineryRate[]
  timesheets            Timesheet[]

  @@index([assignedContractorId])
  @@index([plateNumber])
  @@index([status])
  @@index([createdBy])
}

model MachineryRate {
  id                   String      @id @default(cuid())
  machineryId          String
  rateName             String
  monthlyRate          Float       @default(0)
  dailyRate            Float       @default(0)
  hourlyRate           Float       @default(0)
  contractDaysPerMonth Int         @default(28)
  workHoursPerDay      Int         @default(9)
  isDefault            Boolean     @default(false)
  createdBy            String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  creator              User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  machinery            Machinery   @relation(fields: [machineryId], references: [id], onDelete: Cascade)
  timesheets           Timesheet[]

  @@index([machineryId])
}

model Attendance {
  id             String    @id @default(cuid())
  employeeId     String
  date           DateTime
  status         String
  notes          String?
  overtimeHours  Float     @default(0)
  createdBy      String
  createdAt      DateTime  @default(now())
  approvalStatus String    @default("PENDING")
  approvedById   String?
  approvedAt     DateTime?
  approvalNote   String?
  approver       User?     @relation("AttendanceApprover", fields: [approvedById], references: [id])
  creator        User      @relation(fields: [createdBy], references: [id])
  employee       Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([createdBy])
  @@index([approvalStatus])
}

model EmployeeCashAccount {
  id             String   @id @default(cuid())
  employeeId     String   @unique
  currentBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Employee @relation(fields: [employeeId], references: [id])
}

model CashTransaction {
  id              String    @id @default(cuid())
  employeeId      String
  type            String
  amount          Float
  note            String?
  referenceNumber String?
  createdBy       String
  approvalStatus  String    @default("PENDING")
  approvedById    String?
  approvedAt      DateTime?
  approvalNote    String?
  createdAt       DateTime  @default(now())
  approver        User?     @relation("CashTransactionApprover", fields: [approvedById], references: [id])
  creator         User      @relation(fields: [createdBy], references: [id])
  employee        Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([type])
  @@index([createdBy])
  @@index([createdAt])
  @@index([approvalStatus])
}

model Transfer {
  id              String    @id @default(cuid())
  fromEmployeeId  String
  toEmployeeId    String
  amount          Float
  note            String?
  referenceNumber String?
  createdBy       String
  createdAt       DateTime  @default(now())
  approvalStatus  String    @default("PENDING")
  approvedById    String?
  approvedAt      DateTime?
  approvalNote    String?
  approver        User?     @relation("TransferApprover", fields: [approvedById], references: [id])
  creator         User      @relation(fields: [createdBy], references: [id])
  toEmployee      Employee  @relation("TransferTo", fields: [toEmployeeId], references: [id])
  fromEmployee    Employee  @relation("TransferFrom", fields: [fromEmployeeId], references: [id])

  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@index([createdBy])
  @@index([approvalStatus])
}

model AppSettings {
  id                String    @id @default("default")
  companyName       String    @default("YakhshiLedger")
  companyLogo       String?
  address           String?
  phone             String?
  email             String?
  website           String?
  taxId             String?
  allowSignup       Boolean   @default(false)
  lastSyncTimestamp DateTime?
  updatedAt         DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Asset {
  id                          String              @id @default(cuid())
  name                        String
  category                    String
  purchaseDate                DateTime
  purchasePrice               Float
  currentValue                Float
  quantity                    Int                 @default(1)
  serialNumber                String?
  plateNumber                 String?
  assignedToId                String?
  status                      String              @default("ACTIVE")
  notes                       String?
  images                      String?
  fuelType                    String?
  fuelCapacity                Float?
  fuelLocation                String?
  isMainContainer             Boolean             @default(false)
  createdBy                   String
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  creator                     User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  assignedTo                  Employee?           @relation(fields: [assignedToId], references: [id])
  assetLogs                   AssetLog[]
  fuelDestinationTransactions FuelTransaction[]   @relation("FuelTransactionDestination")
  fuelContainerTransactions   FuelTransaction[]   @relation("FuelTransactionContainer")
  fuelTransactions            FuelTransaction[]   @relation("FuelIssuedToAsset")
  maintenanceRecords          MaintenanceRecord[]

  @@index([assignedToId])
  @@index([category])
  @@index([status])
  @@index([serialNumber])
  @@index([plateNumber])
  @@index([createdBy])
}

model FuelTransaction {
  id                     String      @id @default(cuid())
  type                   String
  fuelType               String
  quantity               Float
  unitPrice              Float?
  totalCost              Float?
  supplier               String?
  assetId                String?
  containerId            String?
  destinationContainerId String?
  contractorId           String?
  machineryId            String?
  issuedToName           String?
  notes                  String?
  date                   DateTime    @default(now())
  createdBy              String
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  creator                User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  machinery              Machinery?  @relation(fields: [machineryId], references: [id])
  contractor             Contractor? @relation(fields: [contractorId], references: [id])
  destinationContainer   Asset?      @relation("FuelTransactionDestination", fields: [destinationContainerId], references: [id])
  container              Asset?      @relation("FuelTransactionContainer", fields: [containerId], references: [id])
  asset                  Asset?      @relation("FuelIssuedToAsset", fields: [assetId], references: [id])
  fuelUsages             FuelUsage[]

  @@index([type])
  @@index([fuelType])
  @@index([assetId])
  @@index([containerId])
  @@index([contractorId])
  @@index([machineryId])
  @@index([date])
  @@index([createdBy])
}

model MaintenanceRecord {
  id              String    @id @default(cuid())
  assetId         String
  serviceDate     DateTime
  serviceType     String
  cost            Float
  description     String?
  vendor          String?
  nextServiceDate DateTime?
  notes           String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  creator         User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([serviceDate])
  @@index([createdBy])
}

model AssetLog {
  id               String    @id @default(cuid())
  assetId          String
  date             DateTime
  startTime        String?
  endTime          String?
  operatorId       String?
  startOdometer    Float?
  endOdometer      Float?
  distanceTraveled Float?
  engineHoursStart Float?
  engineHoursEnd   Float?
  engineHoursUsed  Float?
  fuelConsumed     Float?
  workSite         String?
  project          String?
  conditions       String?
  issues           String?
  status           String    @default("PENDING")
  approvedById     String?
  approvedAt       DateTime?
  approvalStatus   String    @default("PENDING")
  approvalNote     String?
  remarks          String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  approvedBy       User?     @relation("ApprovedByUser", fields: [approvedById], references: [id])
  creator          User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  operator         Employee? @relation(fields: [operatorId], references: [id])
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([operatorId])
  @@index([date])
  @@index([status])
  @@index([approvedById])
  @@index([createdBy])
  @@index([approvalStatus])
}

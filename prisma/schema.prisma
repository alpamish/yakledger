generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                         String              @id @default(cuid())
  email                      String              @unique
  name                       String
  password                   String
  role                       String              @default("USER")
  avatar                     String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  assets                     Asset[]
  approvedAssetLogs          AssetLog[]          @relation("ApprovedByUser")
  assetLogs                  AssetLog[]
  attendanceApprovals        Attendance[]        @relation("AttendanceApprover")
  attendanceRecords          Attendance[]
  auditLogs                  AuditLog[]
  cashTransactionApprovals   CashTransaction[]   @relation("CashTransactionApprover")
  cashTransactions           CashTransaction[]
  contractors                Contractor[]
  employees                  Employee[]
  expenseApprovals           Expense[]           @relation("ExpenseApprover")
  expenses                   Expense[]
  fuelTransactions           FuelTransaction[]
  fuelUsageApprovals         FuelUsage[]         @relation("FuelUsageApprover")
  fuelUsages                 FuelUsage[]
  machinery                  Machinery[]
  machineryRates             MachineryRate[]
  maintenanceRecords         MaintenanceRecord[]
  recordAccesses             RecordAccess[]
  timesheetApprovalApprovals Timesheet[]         @relation("TimesheetApprovalApprover")
  timesheetApprovals         Timesheet[]         @relation("TimesheetApprovedBy")
  timesheets                 Timesheet[]
  transferApprovals          Transfer[]          @relation("TransferApprover")
  transfers                  Transfer[]
  userPermissions            UserPermission[]
  salaryHistories            SalaryHistory[]
  employeeContracts          EmployeeContract[]
  positionHistories          EmployeePositionHistory[]
  uploadedDocuments          EmployeeDocument[]
  employeeLeavesCreated      EmployeeLeave[]      @relation("EmployeeLeaveCreator")
  employeeLeavesApproved     EmployeeLeave[]      @relation("EmployeeLeaveApprover")
  projectAssignmentsCreated  EmployeeProjectAssignment[]
  payrollsCreated            Payroll[]            @relation("PayrollCreator")
  payrollsApproved           Payroll[]            @relation("PayrollApprover")
  employeeAuditEvents        EmployeeAuditEvent[]
  walletUsers                WalletUser[]
  payrollPaymentsCreated     PayrollPayment[]     @relation("PayrollPaymentCreator")
  accountingEntriesPosted    AccountingEntry[]    @relation("AccountingEntryPoster")
  payrollAdjustmentsCreated  PayrollAdjustment[]  @relation("PayrollAdjustmentCreator")
}

model RecordAccess {
  id         String   @id @default(cuid())
  entity     String
  entityId   String
  userId     String
  accessType String   @default("view")
  grantedBy  String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entity, entityId, userId])
  @@index([entity, entityId])
  @@index([userId])
  @@index([entity, userId])
}

model Permission {
  id              String           @id @default(cuid())
  name            String           @unique
  label           String
  description     String?
  module          String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Employee {
  id                    String               @id @default(cuid())
  employeeNumber        String?              @unique
  fullName              String
  fatherName            String
  grandfatherName       String?
  gender                String               @default("male")
  dateOfBirth           DateTime?
  nationality           String?
  phoneNumber           String
  email                 String?
  address               String?
  nationalId            String?
  jobTitle              String
  department            String
  employmentType        String               @default("FULL_TIME")
  // Legacy mutable salary kept for backward compatibility.
  // Canonical salary is now derived from SalaryHistory (amountMinor, currency).
  salary                Float                @default(0)
  // Canonical current salary in minor currency units (e.g. AFN * 100).
  baseSalaryMinor       Int                  @default(0)
  currency              String               @default("AFN")
  workHoursPerDay       Int                  @default(9)
  overtimeRate          Float                @default(1.25)
  workStartTime         String               @default("07:00")
  workEndTime           String               @default("18:00")
  breakMinutes          Int                  @default(60)
  hireDate              DateTime
  status                String               @default("ACTIVE")
  employeeCategory      String?
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  probationEndDate      DateTime?
  terminationDate       DateTime?
  terminationReason     String?
  workLocation          String?
  // supervisor self-relation
  supervisorId          String?
  supervisor            Employee?            @relation("EmployeeSupervisor", fields: [supervisorId], references: [id])
  supervisees           Employee[]           @relation("EmployeeSupervisor")
  // Legacy field kept for compatibility; use terminationDate going forward.
  quitingDate           DateTime?
  idImageFront          String?
  idImageBack           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdBy             String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  assignedAssets        Asset[]
  assetOperatorLogs     AssetLog[]
  attendanceRecords     Attendance[]
  cashTransactions      CashTransaction[]
  creator               User                 @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  cashAccount           EmployeeCashAccount?
  expensesPaidBy        Expense[]            @relation("ExpensePaidBy")
  expensesPaidTo        Expense[]            @relation("ExpensePaidTo")
  transfersTo           Transfer[]           @relation("TransferTo")
  transfersFrom         Transfer[]           @relation("TransferFrom")
  salaryHistory         SalaryHistory[]
  contracts             EmployeeContract[]
  positionHistory       EmployeePositionHistory[]
  documents             EmployeeDocument[]
  leaves                EmployeeLeave[]
  assignments           EmployeeProjectAssignment[]
  payrolls              Payroll[]
  payrollLines          PayrollLine[]
  payrollAdjustments    PayrollAdjustment[]
  auditEvents           EmployeeAuditEvent[]
  wallets               WalletEmployee[]

  @@index([phoneNumber])
  @@index([email])
  @@index([nationalId])
  @@index([department])
  @@index([status])
  @@index([employeeNumber])
  @@index([supervisorId])
  @@index([createdBy])
}

// --- HR: Salary history (immutable historical salary records) ---
model SalaryHistory {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amountMinor   Int
  currency      String   @default("AFN")
  effectiveFrom DateTime
  reason        String?
  notes         String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
}

// --- HR: Contracts (multiple per employee) ---
model EmployeeContract {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  contractNumber String  @unique
  contractType  String   @default("FIXED_TERM")
  startDate     DateTime
  endDate       DateTime?
  salaryMinor   Int      @default(0)
  currency      String   @default("AFN")
  position      String?
  department    String?
  project       String?
  status        String   @default("ACTIVE")
  fileUrl       String?
  notes         String?
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId, startDate])
  @@index([contractNumber])
  @@index([status])
}

// --- HR: Position / department history ---
model EmployeePositionHistory {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position       String
  department     String?
  project        String?
  supervisorId   String?
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  reason         String?
  createdById    String?
  createdBy      User?    @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())

  @@index([employeeId, effectiveFrom])
}

// --- HR: Documents ---
model EmployeeDocument {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType  String
  documentNumber String?
  issueDate     DateTime?
  expiryDate    DateTime?
  fileUrl       String?
  notes         String?
  uploadedById  String?
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
  @@index([documentType])
  @@index([expiryDate])
}

// --- HR: Leave types (configurable) ---
model EmployeeLeaveType {
  id           String  @id @default(cuid())
  name         String  @unique
  description  String?
  isPaid       Boolean @default(true)
  defaultDays  Int?
  isActive     Boolean @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  leaves       EmployeeLeave[]

  @@index([isActive])
}

// --- HR: Leave requests ---
model EmployeeLeave {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String?
  leaveType     EmployeeLeaveType? @relation(fields: [leaveTypeId], references: [id])
  startDate     DateTime
  endDate       DateTime
  days          Float    @default(0)
  reason        String?
  status        String   @default("PENDING")
  approvedById  String?
  approvedBy    User?    @relation("EmployeeLeaveApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  approvalNote  String?
  createdById   String?
  createdBy     User?    @relation("EmployeeLeaveCreator", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId, startDate])
  @@index([status])
  @@index([leaveTypeId])
}

// --- HR: Project assignments (multi, historical) ---
model EmployeeProjectAssignment {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project     String
  position    String?
  startDate   DateTime
  endDate     DateTime?
  notes       String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([employeeId, startDate])
  @@index([project])
}

// --- HR: Payroll (immutable snapshot once approved) ---
model Payroll {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  currency      String   @default("AFN")
  // Lifecycle: DRAFT | APPROVED | PARTIALLY_PAID | PAID | NEEDS_RECALCULATION | CANCELLED
  status        String   @default("DRAFT")
  // STANDARD | FINAL_SETTLEMENT
  type          String   @default("STANDARD")
  // Sum of posted PayrollPayment.amountMinor (integer minor units).
  totalPaidMinor Int     @default(0)
  notes         String?
  walletId      String?
  wallet        Wallet?  @relation(fields: [walletId], references: [id])
  approvedById  String?
  approvedBy    User?    @relation("PayrollApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  revertedById  String?
  revertedAt    DateTime?
  reversalReason String?
  createdById   String?
  createdBy     User?    @relation("PayrollCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lines       PayrollLine[]
  allocations PayrollAdvanceAllocation[]
  expenses    Expense[]
  payments    PayrollPayment[]
  adjustments PayrollAdjustment[]
  accountingEntries AccountingEntry[]

  @@unique([employeeId, periodStart, periodEnd])
  @@index([employeeId, periodStart])
  @@index([status])
  @@index([walletId])
}

// One row per salary payment (partial payments are separate rows).
model PayrollPayment {
  id            String    @id @default(cuid())
  payrollId     String
  payroll       Payroll   @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  amountMinor   Int
  currency      String    @default("AFN")
  // CASH | BANK_TRANSFER | COMPANY_WALLET | ...
  paymentMethod String
  walletId      String?
  wallet        Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)
  reference     String?
  evidenceUrl   String?
  note          String?
  paidAt        DateTime  @default(now())
  createdById   String?
  createdBy     User?     @relation("PayrollPaymentCreator", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([payrollId])
  @@index([paidAt])
  @@index([walletId])
}

// HR-created payroll adjustment (advance-independent).
// kind: PREVIOUS_OVERPAYMENT_DEDUCTION | PREVIOUS_UNDERPAYMENT_EARNING | OTHER
// A reason is always required (enforced in the service layer).
model PayrollAdjustment {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollId   String?
  payroll     Payroll?  @relation(fields: [payrollId], references: [id], onDelete: SetNull)
  kind        String
  amountMinor Int
  currency    String    @default("AFN")
  reason      String
  note        String?
  createdById String?
  createdBy   User?     @relation("PayrollAdjustmentCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([employeeId, createdAt])
  @@index([payrollId])
  @@index([kind])
}

// Journal-style accounting entry. Corrections are posted as reversal +
// corrected entry; posted entries are never silently overwritten or deleted.
model AccountingEntry {
  id          String    @id @default(cuid())
  // PAYROLL_APPROVAL | PAYROLL_PAYMENT | PAYROLL_REVERSAL | ADVANCE_PAYMENT | ...
  type        String
  amountMinor Int
  currency    String    @default("AFN")
  description String?
  payrollId   String?
  payroll     Payroll?  @relation(fields: [payrollId], references: [id], onDelete: SetNull)
  cashTransactionId String?
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id], onDelete: SetNull)
  walletId    String?
  wallet      Wallet?   @relation(fields: [walletId], references: [id], onDelete: SetNull)
  expenseId   String?
  expense     Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  reversalOfId String?
  reversalOf  AccountingEntry?  @relation("AccountingReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals   AccountingEntry[] @relation("AccountingReversal")
  postedById  String?
  postedBy    User?     @relation("AccountingEntryPoster", fields: [postedById], references: [id])
  postedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([payrollId])
  @@index([cashTransactionId])
  @@index([walletId])
  @@index([postedAt])
}


model PayrollLine {
  id                  String   @id @default(cuid())
  payrollId           String
  payroll             Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseSalaryMinor     Int      @default(0)
  currency            String   @default("AFN")
  attendanceDays      Float    @default(0)
  workDays            Int      @default(0)
  overtimeHours       Float    @default(0)
  overtimePayMinor    Int      @default(0)
  allowancesMinor     Int      @default(0)
  bonusesMinor        Int      @default(0)
  deductionsMinor     Int      @default(0)
  grossPayMinor       Int      @default(0)
  expensesPaidMinor   Int      @default(0)
  deductExpenses      Boolean  @default(true)
  amountAlreadyReceivedMinor Int @default(0)
  previousDebtMinor   Int      @default(0)
  advancesDeductedMinor Int     @default(0)
  netPayableMinor     Int      @default(0)
  remainingEmployeeDebtMinor Int @default(0)
  paymentStatus       String   @default("UNPAID")
  paymentMethod       String?
  netPayMinor         Int      @default(0)
  salarySnapshotDate  DateTime?
  createdAt           DateTime @default(now())

  @@index([payrollId])
  @@index([employeeId])
}

// Allocation of an employee cash advance/transaction to a specific payroll,
// so the same received amount is never deducted from earnings twice.
model PayrollAdvanceAllocation {
  id                 String    @id @default(cuid())
  payrollId          String
  payroll            Payroll   @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  cashTransactionId  String
  cashTransaction    CashTransaction @relation(fields: [cashTransactionId], references: [id], onDelete: Cascade)
  amountMinor        Int
  createdAt          DateTime  @default(now())

  @@unique([payrollId, cashTransactionId])
  @@index([payrollId])
  @@index([cashTransactionId])
}

// --- HR: Audit trail for important employee changes ---
model EmployeeAuditEvent {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  action        String
  field         String?
  previousValue String?
  newValue      String?
  effectiveDate DateTime?
  reason        String?
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([employeeId, createdAt])
  @@index([action])
}

model Expense {
  id                 String      @id @default(cuid())
  title              String
  description        String?
  category           String
  amount             Float
  paymentMethod      String
  paidTo             String
  paidBy             String
  expenseDate        DateTime
  attachment         String?
  tags               String?
  notes              String?
  currency           String      @default("AFN")
  createdBy          String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  paidById           String?
  paidToId           String?
  paidToContractorId String?
  paidByContractorId String?
  payrollId          String?
  walletId           String?
  deductFromWallet   Boolean     @default(true)
  assetId            String?
  fuelTransactionId  String?
  // Reimbursement: paid back to the employee who fronted the cost.
  reimbursedAt          DateTime?
  reimbursedById        String?
  reimbursementMethod   String?
  reimbursementTransactionId String?
  approvalStatus     String      @default("PENDING")
  approvedById       String?
  approvedAt         DateTime?
  approvalNote       String?
  approver           User?       @relation("ExpenseApprover", fields: [approvedById], references: [id])
  payroll            Payroll?    @relation(fields: [payrollId], references: [id])
  wallet             Wallet?     @relation(fields: [walletId], references: [id])
  reimbursementTransaction CashTransaction? @relation(fields: [reimbursementTransactionId], references: [id], onDelete: SetNull)
  paidByContractor   Contractor? @relation("ExpensePaidByContractor", fields: [paidByContractorId], references: [id])
  paidToContractor   Contractor? @relation("ExpensePaidToContractor", fields: [paidToContractorId], references: [id])
  paidToEmployee     Employee?   @relation("ExpensePaidTo", fields: [paidToId], references: [id])
  paidByEmployee     Employee?   @relation("ExpensePaidBy", fields: [paidById], references: [id])
  creator            User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  asset              Asset?      @relation("ExpenseAsset", fields: [assetId], references: [id], onDelete: SetNull)
  fuelTransaction    FuelTransaction? @relation("FuelTransactionExpense", fields: [fuelTransactionId], references: [id], onDelete: SetNull)
  fuelUsage          FuelUsage[]
  walletTransactions WalletTransaction[]
  accountingEntries  AccountingEntry[]

  @@index([expenseDate])
  @@index([category])
  @@index([createdBy])
  @@index([paidById])
  @@index([paidToId])
  @@index([paidToContractorId])
  @@index([paidByContractorId])
  @@index([paymentMethod])
  @@index([amount])
  @@index([title])
  @@index([paidBy])
  @@index([paidTo])
  @@index([category, expenseDate])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
  @@index([approvalStatus, expenseDate])
  @@index([approvalStatus, category])
  @@index([paidToId, expenseDate])
  @@index([approvalStatus, paidToContractorId, expenseDate])
  @@index([approvalStatus, createdBy, expenseDate])
  @@index([payrollId])
  @@index([walletId])
  @@index([assetId])
  @@index([fuelTransactionId])
  @@index([paidById, reimbursedAt])
}

model Contractor {
  id               String            @id @default(cuid())
  contractorNumber String?           @unique
  contractorName   String
  fatherName       String
  companyName      String?
  phoneNumber      String
  alternativePhone String?
  email            String?
  address          String?
  nationalId       String?
  contractorType   String
  status           String            @default("ACTIVE")
  notes            String?
  createdBy        String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  idImageBack      String?
  idImageFront     String?
  creator          User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  expensesPaidBy   Expense[]         @relation("ExpensePaidByContractor")
  expensesPaidTo   Expense[]         @relation("ExpensePaidToContractor")
  fuelTransactions FuelTransaction[]
  fuelUsages       FuelUsage[]
  machinery        Machinery[]
  timesheets       Timesheet[]

  @@index([phoneNumber])
  @@index([nationalId])
  @@index([status])
  @@index([createdBy])
}

model Sequence {
  name  String @id
  value Int    @default(1)
}

model Timesheet {
  id               String         @id @default(cuid())
  contractorId     String
  machineryId      String?
  machineryRateId  String?
  operatorName     String?
  workSite         String?
  date             DateTime
  startTime        String?
  lunchStart       String?
  lunchEnd         String?
  endTime          String?
  totalHours       Float          @default(0)
  overtimeHours    Float          @default(0)
  approvedBy       String?
  approvedAt       DateTime?
  approvalStatus   String         @default("PENDING")
  approvedById     String?
  approvalNote     String?
  notes            String?
  createdBy        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  approvalApprover User?          @relation("TimesheetApprovalApprover", fields: [approvedById], references: [id])
  approver         User?          @relation("TimesheetApprovedBy", fields: [approvedBy], references: [id])
  creator          User           @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  machineryRate    MachineryRate? @relation(fields: [machineryRateId], references: [id])
  machinery        Machinery?     @relation(fields: [machineryId], references: [id])
  contractor       Contractor     @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId, date])
  @@index([machineryId])
  @@index([machineryId, date])
  @@index([approvedBy])
  @@index([createdBy])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
  @@index([approvalStatus, contractorId, date])
  @@index([approvalStatus, machineryId, date])
  @@index([approvalStatus, createdBy])
}

model FuelUsage {
  id                String           @id @default(cuid())
  contractorId      String
  machineryId       String?
  fuelType          String
  quantity          Float
  unitPrice         Float
  totalCost         Float
  date              DateTime
  fuelStation       String?
  receiptAttachment String?
  linkedExpenseId   String?
  fuelTransactionId String?
  billable          Boolean         @default(false)
  notes             String?
  createdBy         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  approvalStatus    String           @default("PENDING")
  approvedById      String?
  approvedAt        DateTime?
  approvalNote      String?
  approver          User?            @relation("FuelUsageApprover", fields: [approvedById], references: [id])
  creator           User             @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  fuelTransaction   FuelTransaction? @relation(fields: [fuelTransactionId], references: [id])
  linkedExpense     Expense?         @relation(fields: [linkedExpenseId], references: [id])
  machinery         Machinery?       @relation(fields: [machineryId], references: [id])
  contractor        Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId, date])
  @@index([machineryId])
  @@index([machineryId, date])
  @@index([linkedExpenseId])
  @@index([fuelTransactionId])
  @@index([createdBy])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
  @@index([approvalStatus, contractorId, date])
  @@index([approvalStatus, machineryId, date])
  @@index([approvalStatus, createdBy])
}

  model Machinery {
  id                    String            @id @default(cuid())
  machineryName         String
  machineryType         String
  plateNumber           String?
  model                 String?
  driverName            String?
  driverFatherName      String?
  driverPhoneNumber     String?
  driverNationalId      String?
  driverIdImageFront    String?
  driverIdImageBack     String?
  status                String            @default("OPERATIONAL")
  assignedContractorId  String
  fuelType              String            @default("DIESEL")
  hourlyConsumptionRate Float             @default(0)
  hourlyRate            Float             @default(0)
  dailyRate             Float             @default(0)
  monthlyRate           Float             @default(0)
  contractDaysPerMonth  Int               @default(28)
  workHoursPerDay       Int               @default(9)
  contractStartDate     DateTime?
  contractEndDate       DateTime?
  createdBy             String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  fuelTransactions      FuelTransaction[]
  fuelUsages            FuelUsage[]
  creator               User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  assignedContractor    Contractor        @relation(fields: [assignedContractorId], references: [id], onDelete: Cascade)
  machineryRates        MachineryRate[]
  timesheets            Timesheet[]

  @@index([assignedContractorId])
  @@index([plateNumber])
  @@index([status])
  @@index([createdBy])
}

model MachineryRate {
  id                   String      @id @default(cuid())
  machineryId          String
  rateName             String
  monthlyRate          Float       @default(0)
  dailyRate            Float       @default(0)
  hourlyRate           Float       @default(0)
  contractDaysPerMonth Int         @default(28)
  workHoursPerDay      Int         @default(9)
  isDefault            Boolean     @default(false)
  createdBy            String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  creator              User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  machinery            Machinery   @relation(fields: [machineryId], references: [id], onDelete: Cascade)
  timesheets           Timesheet[]

  @@index([machineryId])
}

model Attendance {
  id             String    @id @default(cuid())
  employeeId     String
  date           DateTime
  status         String
  notes          String?
  overtimeHours  Float     @default(0)
  checkInTime    DateTime?
  checkOutTime   DateTime?
  workedHours    Float     @default(0)
  createdBy      String
  createdAt      DateTime  @default(now())
  approvalStatus String    @default("PENDING")
  approvedById   String?
  approvedAt     DateTime?
  approvalNote   String?
  approver       User?     @relation("AttendanceApprover", fields: [approvedById], references: [id])
  creator        User      @relation(fields: [createdBy], references: [id])
  employee       Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([createdBy])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
}

model EmployeeCashAccount {
  id             String   @id @default(cuid())
  employeeId     String   @unique
  currentBalance Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  employee       Employee @relation(fields: [employeeId], references: [id])
}

model CashTransaction {
  id              String    @id @default(cuid())
  employeeId      String
  type            String
  amount          Float
  note            String?
  referenceNumber String?
  // Optional due date for advances; overdue advances are only warned about.
  dueDate         DateTime?
  // CASH | BANK_TRANSFER | COMPANY_WALLET | ... (set when the advance is paid)
  paymentMethod   String?
  paidAt          DateTime?
  editedById      String?
  editedAt        DateTime?
  createdBy       String
  approvalStatus  String   @default("PENDING")
  approvedById    String?
  approvedAt      DateTime?
  approvalNote    String?
  payrollId       String?
  walletId        String?
  createdAt       DateTime  @default(now())
  approver        User?     @relation("CashTransactionApprover", fields: [approvedById], references: [id])
  creator         User      @relation(fields: [createdBy], references: [id])
  employee        Employee  @relation(fields: [employeeId], references: [id])
  wallet          Wallet?   @relation(fields: [walletId], references: [id])
  payrollAllocations PayrollAdvanceAllocation[]
  accountingEntries  AccountingEntry[]
  reimbursements     Expense[]

  @@index([employeeId])
  @@index([type])
  @@index([createdBy])
  @@index([createdAt])
  @@index([dueDate])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
  @@index([payrollId])
  @@index([walletId])
}

model Wallet {
  id               String             @id @default(cuid())
  name             String
  type             String             @default("CASH")
  currency         String             @default("AFN")
  balance          Float              @default(0)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  transactions     WalletTransaction[]
  cashTransactions CashTransaction[]
  payrolls         Payroll[]
  expenses         Expense[]
  payrollPayments  PayrollPayment[]
  accountingEntries AccountingEntry[]
  employees        WalletEmployee[]
  users            WalletUser[]

  @@index([isActive])
}

model WalletEmployee {
  id         String   @id @default(cuid())
  walletId   String
  employeeId String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([walletId, employeeId])
  @@index([walletId])
  @@index([employeeId])
}

model WalletUser {
  id        String   @id @default(cuid())
  walletId  String
  userId    String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([walletId, userId])
  @@index([walletId])
  @@index([userId])
}

model WalletTransaction {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      String
  amount    Float
  note      String?
  payrollId String?
  expenseId String?
  createdBy String
  createdAt DateTime @default(now())
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([type])
  @@index([payrollId])
  @@index([expenseId])
}

model Transfer {
  id              String    @id @default(cuid())
  fromEmployeeId  String
  toEmployeeId    String
  amount          Float
  note            String?
  referenceNumber String?
  createdBy       String
  createdAt       DateTime  @default(now())
  approvalStatus  String    @default("PENDING")
  approvedById    String?
  approvedAt      DateTime?
  approvalNote    String?
  approver        User?     @relation("TransferApprover", fields: [approvedById], references: [id])
  creator         User      @relation(fields: [createdBy], references: [id])
  toEmployee      Employee  @relation("TransferTo", fields: [toEmployeeId], references: [id])
  fromEmployee    Employee  @relation("TransferFrom", fields: [fromEmployeeId], references: [id])

  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@index([createdBy])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
}

model AppSettings {
  id                String    @id @default("default")
  companyName       String    @default("YakhshiLedger")
  companyLogo       String?
  address           String?
  phone             String?
  email             String?
  website           String?
  taxId             String?
  allowSignup       Boolean   @default(false)
  lastSyncTimestamp DateTime?
  updatedAt         DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Asset {
  id                          String              @id @default(cuid())
  name                        String
  category                    String
  purchaseDate                DateTime
  purchasePrice               Float
  currentValue                Float
  quantity                    Int                 @default(1)
  serialNumber                String?
  plateNumber                 String?
  assignedToId                String?
  status                      String              @default("ACTIVE")
  notes                       String?
  images                      String?
  fuelType                    String?
  fuelCapacity                Float?
  fuelLocation                String?
  isMainContainer             Boolean             @default(false)
  createdBy                   String
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  creator                     User                @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  assignedTo                  Employee?           @relation(fields: [assignedToId], references: [id])
  assetLogs                   AssetLog[]
  fuelDestinationTransactions FuelTransaction[]   @relation("FuelTransactionDestination")
  fuelContainerTransactions   FuelTransaction[]   @relation("FuelTransactionContainer")
  fuelTransactions            FuelTransaction[]   @relation("FuelIssuedToAsset")
  maintenanceRecords          MaintenanceRecord[]
  expenses                    Expense[]           @relation("ExpenseAsset")

  @@index([assignedToId])
  @@index([category])
  @@index([status])
  @@index([serialNumber])
  @@index([plateNumber])
  @@index([createdBy])
}

model FuelTransaction {
  id                     String      @id @default(cuid())
  type                   String
  fuelType               String
  quantity               Float
  unitPrice              Float?
  totalCost              Float?
  supplier               String?
  assetId                String?
  containerId            String?
  destinationContainerId String?
  contractorId           String?
  machineryId            String?
  issuedToName           String?
  notes                  String?
  date                   DateTime    @default(now())
  createdBy              String
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  creator                User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  machinery              Machinery?  @relation(fields: [machineryId], references: [id])
  contractor             Contractor? @relation(fields: [contractorId], references: [id])
  destinationContainer   Asset?      @relation("FuelTransactionDestination", fields: [destinationContainerId], references: [id])
  container              Asset?      @relation("FuelTransactionContainer", fields: [containerId], references: [id])
  asset                  Asset?      @relation("FuelIssuedToAsset", fields: [assetId], references: [id])
  fuelUsages             FuelUsage[]
  expenses               Expense[]      @relation("FuelTransactionExpense")

  @@index([type])
  @@index([fuelType])
  @@index([assetId])
  @@index([containerId])
  @@index([contractorId])
  @@index([machineryId])
  @@index([date])
  @@index([createdBy])
}

model MaintenanceRecord {
  id              String    @id @default(cuid())
  assetId         String
  serviceDate     DateTime
  serviceType     String
  cost            Float
  description     String?
  vendor          String?
  nextServiceDate DateTime?
  notes           String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  creator         User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  asset           Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([serviceDate])
  @@index([createdBy])
}

model AssetLog {
  id               String    @id @default(cuid())
  assetId          String
  date             DateTime
  startTime        String?
  endTime          String?
  operatorId       String?
  startOdometer    Float?
  endOdometer      Float?
  distanceTraveled Float?
  engineHoursStart Float?
  engineHoursEnd   Float?
  engineHoursUsed  Float?
  fuelConsumed     Float?
  workSite         String?
  project          String?
  conditions       String?
  issues           String?
  status           String    @default("PENDING")
  approvedById     String?
  approvedAt       DateTime?
  approvalStatus   String    @default("PENDING")
  approvalNote     String?
  remarks          String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  approvedBy       User?     @relation("ApprovedByUser", fields: [approvedById], references: [id])
  creator          User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  operator         Employee? @relation(fields: [operatorId], references: [id])
  asset            Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([operatorId])
  @@index([date])
  @@index([status])
  @@index([approvedById])
  @@index([createdBy])
  @@index([approvalStatus])
  @@index([approvalStatus, createdAt])
}
